<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/spacing_md"
    android:paddingVertical="@dimen/spacing_xs">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_4xl"
        android:background="@drawable/bg_button_gradient"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_md"
        android:paddingVertical="@dimen/spacing_smd">

        <!-- Reply Quote Box -->
        <LinearLayout
            android:id="@+id/layoutReplyQuote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_xs"
            android:background="@color/rentify_quote_sent_bg"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_sm"
            android:paddingVertical="@dimen/spacing_2xs"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvReplySender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Nguyễn Văn A" />

            <TextView
                android:id="@+id/tvReplyContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/plus_jakarta_sans"
                android:maxLines="2"
                android:textColor="#E2E8F0"
                android:textSize="11sp"
                tools:text="Dạ em gửi ảnh công tơ ạ" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMessageImage"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_marginBottom="@dimen/spacing_xs"
            android:visibility="gone"
            app:cardCornerRadius="@dimen/radius_md"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/ivMessageImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvMessageContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plus_jakarta_sans"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            tools:text="Chào bạn, mình đã nhận được tiền cọc phòng rồi nhé!" />

        <TextView
            android:id="@+id/tvMessageTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/spacing_xs"
            android:alpha="0.8"
            android:fontFamily="@font/plus_jakarta_sans"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            tools:text="14:20" />
    </LinearLayout>

</LinearLayout>
