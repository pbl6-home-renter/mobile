<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_rounded">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_ml">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/spacing_md"
            android:background="@color/rentify_divider" />

        <TextView
            android:id="@+id/tvRateSheetTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plus_jakarta_sans"
            android:text="Thiết lập biểu giá dịch vụ"
            android:textColor="@color/rentify_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRateSheetSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_2xs"
            android:layout_marginBottom="@dimen/spacing_md"
            android:fontFamily="@font/plus_jakarta_sans"
            android:text="Biểu giá áp dụng để tính tiền điện, nước và các dịch vụ định kỳ."
            android:textColor="@color/rentify_text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/layoutRateBlocksContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddRateBlock"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="@dimen/spacing_md"
            android:fontFamily="@font/plus_jakarta_sans"
            android:text="+ Thêm dịch vụ khác"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnInheritBuildingRate"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="@dimen/spacing_sm"
            android:fontFamily="@font/plus_jakarta_sans"
            android:text="Chuyển về kế thừa biểu giá của tòa nhà"
            android:textColor="@color/rentify_text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelRatePolicies"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:layout_weight="1"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Hủy"
                android:textColor="@color/rentify_text_secondary"
                app:cornerRadius="12dp"
                app:strokeColor="@color/rentify_border" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveRatePolicies"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_weight="1"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Lưu thay đổi"
                android:textStyle="bold"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
