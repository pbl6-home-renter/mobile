<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:orientation="vertical"
    android:padding="@dimen/spacing_ml">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/spacing_md"
        android:background="@color/rentify_divider" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/plus_jakarta_sans"
        android:text="Chat mới"
        android:textColor="@color/rentify_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Mode Switch: Chat 1:1 | Tạo nhóm -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupNewChatMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:layout_marginBottom="@dimen/spacing_sm"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipModeDirect"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:fontFamily="@font/plus_jakarta_sans"
            android:text="Chat 1:1"
            android:textSize="13sp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipModeGroup"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plus_jakarta_sans"
            android:text="Tạo nhóm"
            android:textSize="13sp" />
    </com.google.android.material.chip.ChipGroup>

    <!-- Group Title Input (only visible in Group mode) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilNewGroupTitle"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_sm"
        android:hint="Tên nhóm (không bắt buộc)"
        android:visibility="gone"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etNewGroupTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plus_jakarta_sans"
            android:inputType="textCapWords"
            android:textColor="@color/rentify_text_primary"
            android:textSize="13sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Search Users Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilSearchDirectoryUser"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_xs"
        android:hint="Tìm người..."
        app:boxCornerRadiusBottomEnd="16dp"
        app:boxCornerRadiusBottomStart="16dp"
        app:boxCornerRadiusTopEnd="16dp"
        app:boxCornerRadiusTopStart="16dp"
        app:endIconMode="clear_text"
        app:startIconDrawable="@drawable/ic_search"
        app:startIconTint="@color/rentify_text_secondary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSearchDirectoryUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plus_jakarta_sans"
            android:inputType="text"
            android:maxLines="1"
            android:paddingVertical="@dimen/spacing_sm"
            android:textColor="@color/rentify_text_primary"
            android:textSize="13sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tvNewChatModeHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_xs"
        android:fontFamily="@font/plus_jakarta_sans"
        android:text="Chọn 1 người trong danh sách bên dưới để bắt đầu trò chuyện."
        android:textColor="@color/rentify_text_secondary"
        android:textSize="12sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:background="@color/rentify_soft_surface"
        android:padding="@dimen/spacing_xs">

        <LinearLayout
            android:id="@+id/layoutDirectoryUsersList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/layoutGroupFooterActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelNewGroup"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:layout_weight="1"
            android:fontFamily="@font/plus_jakarta_sans"
            android:text="Hủy"
            android:textColor="@color/rentify_text_secondary"
            app:cornerRadius="12dp"
            app:strokeColor="@color/rentify_border" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreateNewGroup"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_weight="1"
            android:enabled="false"
            android:fontFamily="@font/plus_jakarta_sans"
            android:text="Tạo nhóm"
            android:textStyle="bold"
            app:cornerRadius="12dp" />
    </LinearLayout>
</LinearLayout>
