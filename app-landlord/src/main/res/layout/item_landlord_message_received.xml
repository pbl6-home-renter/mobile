<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/spacing_md"
    android:paddingVertical="@dimen/spacing_xs">

    <TextView
        android:id="@+id/tvSenderName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="42dp"
        android:layout_marginBottom="@dimen/spacing_2xs"
        android:fontFamily="@font/plus_jakarta_sans"
        android:textColor="@color/rentify_text_secondary"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="Nguyễn Văn A" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">

        <com.rentify.app.core.ui.view.RentifyAvatarView
            android:id="@+id/senderAvatarView"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="@dimen/spacing_sm"
            app:avatarSize="32dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_3xl"
            app:cardBackgroundColor="@color/rentify_surface"
            app:cardCornerRadius="@dimen/radius_lg"
            app:cardElevation="1dp"
            app:strokeColor="@color/rentify_divider"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/spacing_md"
                android:paddingVertical="@dimen/spacing_smd">

                <!-- Reply Quote Box -->
                <LinearLayout
                    android:id="@+id/layoutReplyQuote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_xs"
                    android:background="@color/rentify_soft_surface"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/spacing_sm"
                    android:paddingVertical="@dimen/spacing_2xs"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvReplySender"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:textColor="@color/rentify_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="Chủ trọ" />

                    <TextView
                        android:id="@+id/tvReplyContent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:maxLines="2"
                        android:textColor="@color/rentify_text_secondary"
                        android:textSize="11sp"
                        tools:text="Nhớ nộp tiền phòng đúng hạn nhé" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMessageImage"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:layout_marginBottom="@dimen/spacing_xs"
                    android:visibility="gone"
                    app:cardCornerRadius="@dimen/radius_md"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/ivMessageImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvMessageContent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:textColor="@color/rentify_text_primary"
                    android:textSize="14sp"
                    tools:text="Dạ em cảm ơn anh, cuối tuần này em dọn vào trọ ạ!" />

                <TextView
                    android:id="@+id/tvMessageTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:textColor="@color/rentify_text_secondary"
                    android:textSize="10sp"
                    tools:text="14:22" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

</LinearLayout>
