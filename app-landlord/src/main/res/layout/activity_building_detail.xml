<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rentify_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/rentify_surface"
        android:elevation="2dp"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/rentify_text_primary"
        app:title="Chi tiết Tòa nhà"
        app:titleTextAppearance="@style/RentifyBottomNavActive"
        app:titleTextColor="@color/rentify_text_primary" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Main Info Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/rentify_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/rentify_divider"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvDetailName"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:textColor="@color/rentify_text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                tools:text="Tòa nhà Rentify Central Park" />

                            <TextView
                                android:id="@+id/tvDetailStatusBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                tools:text="Đã duyệt" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvDetailFullAddress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:textColor="@color/rentify_text_secondary"
                            android:textSize="14sp"
                            tools:text="123 Nguyễn Thị Minh Khai, Phường Bến Nghé, TP. Hồ Chí Minh" />

                        <!-- Rejection / Review note if present -->
                        <LinearLayout
                            android:id="@+id/layoutDetailReviewNote"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="#FEE2E2"
                            android:orientation="vertical"
                            android:padding="10dp"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="Ghi chú từ quản trị viên:"
                                android:textColor="#DC2626"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvDetailReviewNote"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:textColor="#B91C1C"
                                android:textSize="13sp"
                                tools:text="Yêu cầu bổ sung sổ đỏ hợp lệ." />
                        </LinearLayout>

                        <!-- Stats Divider -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="12dp"
                            android:background="@color/rentify_divider" />

                        <!-- Occupancy Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:text="Phòng đang thuê"
                                    android:textColor="@color/rentify_text_secondary"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/tvDetailOccupiedRooms"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:textColor="@color/rentify_text_primary"
                                    android:textSize="15sp"
                                    android:textStyle="bold"
                                    tools:text="15 phòng" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:text="Tỷ lệ lấp đầy"
                                    android:textColor="@color/rentify_text_secondary"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/tvDetailOccupancyRate"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:textColor="@color/rentify_primary"
                                    android:textSize="15sp"
                                    android:textStyle="bold"
                                    tools:text="75%" />
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- VietQR Config Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/rentify_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/rentify_divider"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="Thanh toán VietQR tòa nhà"
                            android:textColor="@color/rentify_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvVietQrStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:textColor="@color/rentify_text_secondary"
                            android:textSize="13sp"
                            tools:text="Chưa cấu hình tài khoản VietQR" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnConfigVietQr"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="12dp"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="Cấu hình tài khoản nhận tiền"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:cornerRadius="12dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Action Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEditBuilding"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="Chỉnh sửa"
                        android:textColor="@color/rentify_primary"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        app:strokeColor="@color/rentify_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDeleteBuilding"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="Xóa tòa nhà"
                        android:textColor="@color/rentify_error"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        app:strokeColor="@color/rentify_error" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/detailProgressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="20dp"
                    android:visibility="gone" />

            </LinearLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>

