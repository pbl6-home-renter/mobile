<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rentify_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/rentify_surface"
        android:elevation="2dp"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/rentify_text_primary"
        app:title="Chi tiết Hợp đồng"
        app:titleTextAppearance="@style/RentifyBottomNavActive"
        app:titleTextColor="@color/rentify_text_primary" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Main Info Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/rentify_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/rentify_divider"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvDetailContractCode"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:textColor="@color/rentify_text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                tools:text="HĐ-3fa85f" />

                            <TextView
                                android:id="@+id/tvDetailStatusBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                tools:text="Đang hiệu lực" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvDetailRoomName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:textColor="@color/rentify_primary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="Phòng P.201" />

                        <TextView
                            android:id="@+id/tvDetailTenantInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:textColor="@color/rentify_text_secondary"
                            android:textSize="13sp"
                            tools:text="Khách thuê: Trần Thị B • SĐT: 0901 234 567" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="12dp"
                            android:background="@color/rentify_divider" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:text="Giá thuê / tháng"
                                    android:textColor="@color/rentify_text_muted"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/tvDetailRentPrice"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:textColor="@color/rentify_primary"
                                    android:textSize="15sp"
                                    android:textStyle="bold"
                                    tools:text="3.500.000 đ" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:text="Tiền đặt cọc"
                                    android:textColor="@color/rentify_text_muted"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/tvDetailDepositAmount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:textColor="@color/rentify_text_primary"
                                    android:textSize="15sp"
                                    android:textStyle="bold"
                                    tools:text="3.500.000 đ" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="12dp"
                            android:background="@color/rentify_divider" />

                        <TextView
                            android:id="@+id/tvDetailDuration"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:textColor="@color/rentify_text_secondary"
                            android:textSize="13sp"
                            tools:text="Thời hạn: 01/10/2026 → 01/10/2027" />

                        <TextView
                            android:id="@+id/tvDetailVehicleCount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:textColor="@color/rentify_text_secondary"
                            android:textSize="13sp"
                            tools:text="Số xe máy gửi: 1 xe" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Members Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/rentify_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/rentify_divider"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="Thành viên ở ghép"
                                android:textColor="@color/rentify_text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAddMember"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="+ Thêm"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                app:cornerRadius="18dp" />
                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvContractMembers"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:nestedScrollingEnabled="false" />

                        <TextView
                            android:id="@+id/tvEmptyMembers"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="Chưa có thành viên ở ghép nào được đăng ký."
                            android:textColor="@color/rentify_text_muted"
                            android:textSize="13sp"
                            android:visibility="gone" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Actions Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardBackgroundColor="@color/rentify_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/rentify_divider"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="Thao tác hợp đồng"
                            android:textColor="@color/rentify_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <!-- Activate Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnActivateContract"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="12dp"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="Kích hoạt hợp đồng (Đã ký)"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:visibility="gone"
                            app:cornerRadius="12dp" />

                        <!-- Checkout & Settle Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCheckoutAndSettle"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="12dp"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="Trả phòng &amp; Quyết toán cọc"
                            android:textColor="@color/rentify_error"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:visibility="gone"
                            app:cornerRadius="12dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone" />

            </LinearLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>

