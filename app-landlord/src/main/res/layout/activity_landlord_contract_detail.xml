<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rentify_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/rentify_surface"
        android:elevation="2dp"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/rentify_text_primary"
        app:title="Chi tiết Hợp đồng"
        app:titleTextAppearance="@style/RentifyBottomNavActive"
        app:titleTextColor="@color/rentify_text_primary" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 1. Thông tin hợp đồng -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_md"
                    app:cardBackgroundColor="@color/rentify_surface"
                    app:cardCornerRadius="@dimen/radius_lg"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/rentify_divider"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvDetailContractCode"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:textColor="@color/rentify_text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                tools:text="HD-596687" />

                            <TextView
                                android:id="@+id/tvDetailStatusBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:paddingHorizontal="@dimen/spacing_smd"
                                android:paddingVertical="@dimen/spacing_xs"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                tools:text="Đang hiệu lực" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvDetailRoomName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:textColor="@color/rentify_primary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="Phòng DTN 101" />

                        <TextView
                            android:id="@+id/tvDetailTenantInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:textColor="@color/rentify_text_secondary"
                            android:textSize="13sp"
                            tools:text="Người đại diện: Trần Thị B • SĐT: 0901 234 567" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="@dimen/spacing_smd"
                            android:background="@color/rentify_divider" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:text="Giá thuê / tháng"
                                    android:textColor="@color/rentify_text_muted"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/tvDetailRentPrice"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/spacing_2xs"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:textColor="@color/rentify_primary"
                                    android:textSize="15sp"
                                    android:textStyle="bold"
                                    tools:text="3.500.000 đ" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:text="Tiền đặt cọc"
                                    android:textColor="@color/rentify_text_muted"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/tvDetailDepositAmount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/spacing_2xs"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:textColor="@color/rentify_text_primary"
                                    android:textSize="15sp"
                                    android:textStyle="bold"
                                    tools:text="3.500.000 đ" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="@dimen/spacing_smd"
                            android:background="@color/rentify_divider" />

                        <TextView
                            android:id="@+id/tvDetailDuration"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:textColor="@color/rentify_text_secondary"
                            android:textSize="13sp"
                            tools:text="Thời hạn hợp đồng: 01/10/2026 → 01/10/2027" />

                        <TextView
                            android:id="@+id/tvDetailVehicleCount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:textColor="@color/rentify_text_secondary"
                            android:textSize="13sp"
                            tools:text="Số xe gửi: 1 xe" />

                        <TextView
                            android:id="@+id/tvDetailContractNote"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:textColor="@color/rentify_text_secondary"
                            android:textSize="13sp"
                            tools:text="Ghi chú: Không có ghi chú" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_smd"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnEditContractMeta"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="Sửa số xe &amp; ghi chú"
                                android:textColor="@color/rentify_primary"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                app:cornerRadius="12dp"
                                app:strokeColor="@color/rentify_primary" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnCheckoutAndSettle"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_marginStart="@dimen/spacing_sm"
                                android:layout_weight="1"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="Trả phòng (Checkout)"
                                android:textColor="@color/rentify_error"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:visibility="gone"
                                app:cornerRadius="12dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 2. Tài liệu & Kích hoạt hợp đồng (3 bước như Web) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardContractDocuments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_md"
                    app:cardBackgroundColor="@color/rentify_surface"
                    app:cardCornerRadius="@dimen/radius_lg"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/rentify_divider"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="Tài liệu &amp; Kích hoạt hợp đồng"
                            android:textColor="@color/rentify_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <!-- Step 1: Áp mẫu hợp đồng -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_smd"
                            android:background="@color/rentify_soft_surface"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_smd">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="1. Áp mẫu hợp đồng"
                                android:textColor="@color/rentify_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xs"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/tilContractTemplate"
                                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="@dimen/spacing_xs"
                                    android:layout_weight="1"
                                    android:hint="Chọn mẫu hợp đồng..."
                                    app:boxBackgroundColor="@color/rentify_surface"
                                    app:boxCornerRadiusBottomEnd="10dp"
                                    app:boxCornerRadiusBottomStart="10dp"
                                    app:boxCornerRadiusTopEnd="10dp"
                                    app:boxCornerRadiusTopStart="10dp">

                                    <AutoCompleteTextView
                                        android:id="@+id/actvContractTemplate"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/plus_jakarta_sans"
                                        android:inputType="none"
                                        android:paddingVertical="@dimen/spacing_sm"
                                        android:textColor="@color/rentify_text_primary"
                                        android:textSize="12sp" />
                                </com.google.android.material.textfield.TextInputLayout>

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnApplyTemplate"
                                    style="@style/Widget.Material3.Button.TonalButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="44dp"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:text="Áp mẫu"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    app:cornerRadius="10dp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvAppliedTemplateInfo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_2xs"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:textColor="@color/rentify_text_secondary"
                                android:textSize="11sp"
                                tools:text="Mẫu hiện tại: Chưa áp dụng mẫu" />
                        </LinearLayout>

                        <!-- Step 2: Sinh bản nháp PDF -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:background="@color/rentify_soft_surface"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_smd">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="2. Sinh bản nháp PDF"
                                android:textColor="@color/rentify_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvDraftPdfHint"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_2xs"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="Hãy áp dụng mẫu trước khi tạo bản nháp PDF."
                                android:textColor="@color/rentify_text_secondary"
                                android:textSize="12sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnGenerateDraftPdf"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="match_parent"
                                android:layout_height="42dp"
                                android:layout_marginTop="@dimen/spacing_xs"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="Sinh &amp; Tải bản nháp PDF"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                app:cornerRadius="10dp" />
                        </LinearLayout>

                        <!-- Step 3: Upload bản ký & Kích hoạt -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:background="@color/rentify_soft_surface"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_smd">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="3. Upload bản ký &amp; Kích hoạt"
                                android:textColor="@color/rentify_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <!-- Hiển thị khi đã active -->
                            <TextView
                                android:id="@+id/tvContractActiveNotice"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xs"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="✓ Đã kích hoạt — Hợp đồng này đang có hiệu lực. Phòng đang ở trạng thái Đang thuê (Occupied)."
                                android:textColor="@color/rentify_success"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:visibility="gone" />

                            <!-- Hiển thị khi còn ở trạng thái draft / signed -->
                            <LinearLayout
                                android:id="@+id/layoutUploadAndActivate"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xs"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvSignedFileStatus"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:text="Tải lên bản hợp đồng đã ký (PDF, PNG, JPEG, WebP ≤ 10 MB)"
                                    android:textColor="@color/rentify_text_secondary"
                                    android:textSize="12sp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnSelectSignedFile"
                                    style="@style/Widget.Material3.Button.TonalButton"
                                    android:layout_width="match_parent"
                                    android:layout_height="42dp"
                                    android:layout_marginTop="@dimen/spacing_xs"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:text="Chọn file tải lên"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    app:cornerRadius="10dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnActivateContract"
                                    style="@style/Widget.Material3.Button"
                                    android:layout_width="match_parent"
                                    android:layout_height="46dp"
                                    android:layout_marginTop="@dimen/spacing_sm"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:text="Kích hoạt hợp đồng"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    app:cornerRadius="10dp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. Thành viên hợp đồng -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_lg"
                    app:cardBackgroundColor="@color/rentify_surface"
                    app:cardCornerRadius="@dimen/radius_lg"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/rentify_divider"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvMembersTitleCount"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="Thành viên hợp đồng"
                                android:textColor="@color/rentify_text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAddMember"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="+ Thêm thành viên"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                app:cornerRadius="18dp" />
                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvContractMembers"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_smd"
                            android:nestedScrollingEnabled="false" />

                        <TextView
                            android:id="@+id/tvEmptyMembers"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="Chưa có thành viên ở ghép nào được đăng ký."
                            android:textColor="@color/rentify_text_muted"
                            android:textSize="13sp"
                            android:visibility="gone" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
