<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Rentify"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.favoriteroom.FavoriteRoomsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.search.SearchResultActivity"
            android:exported="false" />
        <activity
            android:name=".ui.chat.detail.ChatDetailActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.matching.detail.RoommateDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.matching.profile.EditRoommateProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.room.detail.RoomDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.issue.create.CreateIssueActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.issue.list.MyIssuesActivity"
            android:exported="false" />
        <activity
            android:name=".ui.issue.detail.IssueDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.contract.list.MyContractsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.contract.detail.ContractDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.invoice.list.MyInvoicesActivity"
            android:exported="false" />
        <activity
            android:name=".ui.invoice.detail.InvoiceDetailActivity"
            android:exported="false" />
    </application>

</manifest>
