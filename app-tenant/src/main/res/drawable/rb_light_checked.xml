<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="oval">
            <size android:width="18dp" android:height="18dp" />
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1.25dp"
                android:color="@color/rentify_primary" />
        </shape>
    </item>
    <item
        android:bottom="8dp"
        android:left="8dp"
        android:right="8dp"
        android:top="8dp">
        <shape android:shape="oval">
            <solid android:color="@color/rentify_primary" />
        </shape>
    </item>
</layer-list>
