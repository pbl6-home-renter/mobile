<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_rounded_surface"
    android:orientation="vertical"
    android:padding="@dimen/spacing_lg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/plus_jakarta_sans"
        android:text="Thêm thành viên vào nhóm"
        android:textColor="@color/rentify_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:fontFamily="@font/plus_jakarta_sans"
        android:text="Nhập ID người dùng bạn muốn thêm vào cuộc trò chuyện này."
        android:textColor="@color/rentify_text_secondary"
        android:textSize="13sp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        app:cardBackgroundColor="@color/sl_textfield_card_bg"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/sl_textfield_card_stroke"
        app:strokeWidth="1.5dp">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="User ID *"
            android:textColorHint="@color/rentify_text_muted"
            app:boxBackgroundColor="@android:color/transparent"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="0dp"
            app:cursorColor="@color/rentify_primary"
            app:hintTextColor="@color/rentify_primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtAddMemberIds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:fontFamily="@font/plus_jakarta_sans_regular"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:paddingTop="26dp"
                android:paddingBottom="12dp"
                android:textColor="@color/rentify_text"
                android:textCursorDrawable="@drawable/bg_cursor_primary"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/plus_jakarta_sans_regular"
        android:text="Có thể nhập nhiều ID phân tách bằng dấu phẩy (,)"
        android:textColor="@color/rentify_text_muted"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_ml"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plus_jakarta_sans"
            android:text="Hủy"
            android:textColor="@color/rentify_text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:fontFamily="@font/plus_jakarta_sans"
            android:text="Thêm"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>

