<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rentify_background"
    android:orientation="vertical">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/rentify_surface"
        android:elevation="2dp"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/rentify_text_primary"
        app:title="Báo cáo sự cố"
        app:titleTextColor="@color/rentify_text_primary" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <!-- Room info Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rounded_surface"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_md">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_icon_squircle"
                    android:padding="@dimen/spacing_sm"
                    android:src="@drawable/ic_location_pin"
                    app:tint="@color/rentify_primary"
                    android:contentDescription="Phòng" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_smd"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Khu vực xảy ra sự cố"
                        android:textColor="@color/rentify_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvRoomName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_2xs"
                        android:textColor="@color/rentify_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="Phòng P.201" />
                </LinearLayout>
            </LinearLayout>

            <!-- Issue Title -->
            <com.rentify.app.core.ui.component.RentifyTextField
                android:id="@+id/etTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_ml"
                android:imeOptions="actionNext"
                android:inputType="textCapSentences"
                app:hint="Tiêu đề sự cố *" />

            <!-- Category Selector -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_ml"
                android:text="Nhóm sự cố *"
                android:textColor="@color/rentify_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                app:chipSpacing="8dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPlumbing"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Đường nước"
                    app:chipIcon="@drawable/ic_issue_plumbing"
                    app:chipIconSize="18dp"
                    app:chipIconVisible="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipElectrical"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hệ thống điện"
                    app:chipIcon="@drawable/ic_issue_electrical"
                    app:chipIconSize="18dp"
                    app:chipIconVisible="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAppliance"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thiết bị gia dụng"
                    app:chipIcon="@drawable/ic_issue_appliance"
                    app:chipIconSize="18dp"
                    app:chipIconVisible="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipStructural"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cửa / Kết cấu"
                    app:chipIcon="@drawable/ic_issue_structural"
                    app:chipIconSize="18dp"
                    app:chipIconVisible="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSecurity"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="An ninh / Khóa"
                    app:chipIcon="@drawable/ic_issue_security"
                    app:chipIconSize="18dp"
                    app:chipIconVisible="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipOther"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Khác"
                    app:chipIcon="@drawable/ic_issue_other"
                    app:chipIconSize="18dp"
                    app:chipIconVisible="true" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Urgency Selector -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_ml"
                android:text="Mức độ khẩn cấp *"
                android:textColor="@color/rentify_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupUrgency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                app:chipSpacing="8dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipUrgencyLow"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thấp"
                    app:chipIcon="@drawable/ic_dot_low"
                    app:chipIconSize="10dp"
                    app:chipIconVisible="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipUrgencyMedium"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Trung bình"
                    app:chipIcon="@drawable/ic_dot_medium"
                    app:chipIconSize="10dp"
                    app:chipIconVisible="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipUrgencyHigh"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cao"
                    app:chipIcon="@drawable/ic_dot_high"
                    app:chipIconSize="10dp"
                    app:chipIconVisible="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipUrgencyEmergency"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Khẩn cấp"
                    app:chipIcon="@drawable/ic_dot_emergency"
                    app:chipIconSize="10dp"
                    app:chipIconVisible="true" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Description -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_ml"
                app:cardBackgroundColor="@color/sl_textfield_card_bg"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/sl_textfield_card_stroke"
                app:strokeWidth="1.5dp">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Mô tả chi tiết"
                    android:textColorHint="@color/rentify_text_muted"
                    app:boxBackgroundColor="@android:color/transparent"
                    app:boxStrokeWidth="0dp"
                    app:boxStrokeWidthFocused="0dp"
                    app:counterEnabled="true"
                    app:counterMaxLength="500"
                    app:cursorColor="@color/rentify_primary"
                    app:hintTextColor="@color/rentify_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:fontFamily="@font/plus_jakarta_sans_regular"
                        android:gravity="top"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLength="500"
                        android:minLines="4"
                        android:paddingTop="26dp"
                        android:paddingBottom="12dp"
                        android:textColor="@color/rentify_text"
                        android:textCursorDrawable="@drawable/bg_cursor_primary"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Submit Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/rentify_surface"
        android:elevation="8dp"
        android:padding="@dimen/spacing_md">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitIssue"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_button_gradient"
            android:text="Gửi báo cáo sự cố"
            android:textColor="@color/rentify_on_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:cornerRadius="25dp" />
    </LinearLayout>

    <com.rentify.app.tenant.ui.component.TenantLoadingView
        android:id="@+id/pbLoading"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:visibility="gone" />

</LinearLayout>

