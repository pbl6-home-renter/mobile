<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rentify_surface"
    android:orientation="vertical">

    <!-- 2. Header màn chat -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/rentify_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- Trái: nút quay lại (icon chevron trái 24dp, vùng bấm 44dp) -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Quay lại"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chevron_left"
            app:tint="@color/rentify_text" />

        <!-- Giữa (căn giữa màn hình): RentifyAvatarView 36dp + tên 13sp medium -->
        <LinearLayout
            android:id="@+id/layoutHeaderCenter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp">

            <com.rentify.app.core.ui.view.RentifyAvatarView
                android:id="@+id/headerAvatarView"
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:avatarSize="36dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtHeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:maxWidth="220dp"
                    android:textColor="@color/rentify_text"
                    android:textSize="13sp"
                    tools:text="Nhà trọ Thanh Xuân" />

                <ImageView
                    android:id="@+id/ivHeaderChevronRight"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="3dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    android:visibility="gone"
                    app:tint="@color/rentify_text_faint"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtHeaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:fontFamily="@font/plus_jakarta_sans"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/rentify_text_faint"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="3 thành viên"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Phải: Khoảng trống bằng chiều rộng nút quay lại (44dp) để phần giữa luôn đúng tâm -->
        <View
            android:id="@+id/viewHeaderRightSpacer"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <!-- Đường kẻ dưới header 1dp rentify_divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/rentify_divider"
        android:importantForAccessibility="no" />

    <!-- Vùng danh sách tin nhắn + Thanh nhập tin nổi -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/rentify_surface"
        android:clipChildren="false"
        android:clipToPadding="false">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMessages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/rentify_surface"
            android:clipToPadding="false"
            android:paddingTop="12dp"
            android:paddingBottom="88dp"
            tools:listitem="@layout/item_message_me" />

        <!-- Load more indicator (at top) -->
        <com.rentify.app.tenant.ui.component.TenantLoadingView
            android:id="@+id/pbLoadMore"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="@dimen/spacing_xs"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Initial loading indicator -->
        <com.rentify.app.tenant.ui.component.TenantLoadingView
            android:id="@+id/pbInitialLoading"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Cụm đáy: Thanh xem trước trả lời + Thanh nhập tin nổi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <!-- Reply Target Bar (Hidden by default) -->
            <LinearLayout
                android:id="@+id/layoutReplyBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_chat_search_box"
                android:elevation="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:visibility="gone">

                <View
                    android:layout_width="3dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="8dp"
                    android:background="@color/rentify_primary"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvReplySenderName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_medium"
                        android:textColor="@color/rentify_primary"
                        android:textSize="12sp"
                        tools:text="Trả lời Nguyễn Văn A" />

                    <TextView
                        android:id="@+id/tvReplyPreview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:maxLines="1"
                        android:textColor="@color/rentify_text_secondary"
                        android:textSize="12sp"
                        tools:text="Dạ thợ mấy giờ qua kiểm được ạ" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnCancelReply"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Hủy trả lời"
                    android:src="@drawable/ic_close"
                    app:tint="@color/rentify_text_faint" />
            </LinearLayout>

            <!-- 4. Thanh nhập tin nổi (cách trái/phải/dưới 12dp/12dp/14dp, cao 52dp) -->
            <LinearLayout
                android:id="@+id/layoutInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_chat_input_bar_pill"
                android:elevation="6dp"
                android:gravity="bottom"
                android:minHeight="52dp"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="6dp"
                android:paddingEnd="6dp"
                android:paddingBottom="6dp">

                <!-- Trái: nút tròn 36dp nền rentify_field_bg, icon dấu cộng 19dp -->
                <ImageButton
                    android:id="@+id/btnAttachImage"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/bg_chat_header_icon_btn"
                    android:contentDescription="Đính kèm ảnh"
                    android:padding="8.5dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_plus"
                    app:tint="@color/rentify_text_secondary" />

                <!-- Giữa: ô nhập không viền, nền trong suốt, hint "Nhắn tin…" 14sp rentify_text_faint, tối đa 4 dòng -->
                <EditText
                    android:id="@+id/edtMessage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginHorizontal="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:hint="Nhắn tin…"
                    android:importantForAutofill="no"
                    android:includeFontPadding="false"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="4"
                    android:minHeight="36dp"
                    android:gravity="center_vertical"
                    android:paddingVertical="6dp"
                    android:textColor="@color/rentify_text"
                    android:textColorHint="@color/rentify_text_faint"
                    android:textCursorDrawable="@drawable/bg_cursor_primary"
                    android:textSize="14sp" />

                <!-- Phải: nút gửi tròn 40dp, icon mũi tên lên 20dp -->
                <ImageButton
                    android:id="@+id/btnSend"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/bg_pill_button"
                    android:contentDescription="Gửi tin nhắn"
                    android:enabled="false"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_arrow_up"
                    app:tint="@color/text_pill_button" />
            </LinearLayout>
        </LinearLayout>

    </FrameLayout>

</LinearLayout>
