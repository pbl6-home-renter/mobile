<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefreshLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rentify_background">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- HEADER BANNER IMAGE -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/viewHeaderContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/ivHeaderBanner"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="Header Banner"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_explore_banner"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:src="@drawable/img_explore_banner" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="#2E000000"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Container chứa nội dung Text và Button của Header -->
                <FrameLayout
                    android:id="@+id/layoutHeaderContent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingTop="20dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="44dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <!-- Header cho khách (Guest) -->
                    <RelativeLayout
                        android:id="@+id/layoutGuestHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:layout_toStartOf="@id/btnGuestLogin"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvGuestGreeting"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="Xin chào!"
                                android:textColor="@color/rentify_on_primary"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="Tìm phòng trọ ưng ý cùng Rentify"
                                android:textColor="#DCE7FD"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnGuestLogin"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:backgroundTint="@color/rentify_surface"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingHorizontal="14dp"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:text="Đăng nhập"
                            android:textColor="@color/rentify_primary_gradient_start"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:cornerRadius="19dp"
                            app:elevation="2dp"
                            app:icon="@drawable/ic_user_circle"
                            app:iconGravity="textStart"
                            app:iconPadding="6dp"
                            app:iconSize="16dp"
                            app:iconTint="@color/rentify_primary_gradient_start" />
                    </RelativeLayout>

                    <!-- Header cho người dùng đã đăng nhập -->
                    <RelativeLayout
                        android:id="@+id/layoutUserHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="visible">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:layout_toStartOf="@id/layoutNotificationContainer"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- Avatar tròn (viết tắt hoặc ảnh) -->
                            <FrameLayout
                                android:id="@+id/btnAvatar"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_circle_icon_button">

                                <TextView
                                    android:id="@+id/tvUserAvatarLetter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:textColor="@color/rentify_on_primary"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    tools:text="MA" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvUserGreeting"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:maxLines="1"
                                    android:textColor="@color/rentify_on_primary"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    tools:text="Xin chào, Minh Anh" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:text="Hôm nay bạn muốn tìm phòng ở đâu?"
                                    android:textColor="#DCE7FD"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Nút Chuông thông báo -->
                        <FrameLayout
                            android:id="@+id/layoutNotificationContainer"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true">

                            <ImageView
                                android:id="@+id/btnNotification"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_circle_icon_button"
                                android:contentDescription="Thông báo"
                                android:padding="9dp"
                                android:src="@drawable/ic_notification"
                                app:tint="@color/rentify_on_primary" />

                            <View
                                android:id="@+id/ivNotificationBadge"
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_gravity="top|end"
                                android:layout_marginTop="3dp"
                                android:layout_marginEnd="3dp"
                                android:background="@drawable/bg_circle_icon_badge"
                                android:visibility="gone"
                                tools:visibility="visible" />
                        </FrameLayout>
                    </RelativeLayout>
                </FrameLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- THANH TÌM KIẾM ĐÈ MÉP DƯỚI HEADER -->
            <LinearLayout
                android:id="@+id/layoutSearchBar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="-24dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_search_bar"
                android:elevation="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_vertical"
                    android:contentDescription="Tìm kiếm"
                    android:src="@drawable/ic_search"
                    app:tint="#94A3B8" />

                <TextView
                    android:id="@+id/tvSearchQuery"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="Tìm phòng trọ, khu vực..."
                    android:textColor="#64748B"
                    android:textSize="14sp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginHorizontal="8dp"
                    android:background="@color/rentify_divider" />

                <ImageView
                    android:id="@+id/btnExploreFilter"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center_vertical"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Lọc phòng"
                    android:padding="5dp"
                    android:src="@drawable/ic_filter"
                    app:tint="@color/rentify_primary_gradient_start" />
            </LinearLayout>

            <!-- 4 TIỆN ÍCH TRÊN KHỐI TRẮNG -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardQuickUtilities"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="16dp"
                app:cardBackgroundColor="@color/rentify_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/rentify_divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="14dp">

                    <!-- 1. Tìm gần tôi -->
                    <LinearLayout
                        android:id="@+id/btnUtilNearMe"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="4dp">

                        <FrameLayout
                            android:layout_width="46dp"
                            android:layout_height="46dp">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                app:cardBackgroundColor="@color/rentify_card_near_bg"
                                app:cardCornerRadius="23dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="Tìm gần tôi"
                                    android:src="@drawable/ic_location_pin"
                                    app:tint="@color/rentify_primary_gradient_start" />
                            </com.google.android.material.card.MaterialCardView>
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/plus_jakarta_sans_medium"
                            android:text="Tìm gần tôi"
                            android:textColor="@color/rentify_text_primary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- 2. Trọ đã lưu -->
                    <LinearLayout
                        android:id="@+id/btnUtilSavedRooms"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="4dp">

                        <FrameLayout
                            android:layout_width="46dp"
                            android:layout_height="46dp">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                app:cardBackgroundColor="@color/rentify_card_near_bg"
                                app:cardCornerRadius="23dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="Trọ đã lưu"
                                    android:src="@drawable/ic_heart_filled"
                                    app:tint="@color/rentify_primary_gradient_start" />
                            </com.google.android.material.card.MaterialCardView>
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/plus_jakarta_sans_medium"
                            android:text="Trọ đã lưu"
                            android:textColor="@color/rentify_text_primary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- 3. Ghép bạn -->
                    <LinearLayout
                        android:id="@+id/btnUtilMatchFriends"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="4dp">

                        <FrameLayout
                            android:layout_width="46dp"
                            android:layout_height="46dp">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                app:cardBackgroundColor="@color/rentify_card_near_bg"
                                app:cardCornerRadius="23dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="Ghép bạn"
                                    android:src="@drawable/ic_nav_matching"
                                    app:tint="@color/rentify_primary_gradient_start" />
                            </com.google.android.material.card.MaterialCardView>
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/plus_jakarta_sans_medium"
                            android:text="Ghép bạn"
                            android:textColor="@color/rentify_text_primary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- 4. Hóa đơn -->
                    <LinearLayout
                        android:id="@+id/btnUtilInvoices"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="4dp">

                        <FrameLayout
                            android:layout_width="46dp"
                            android:layout_height="46dp">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                app:cardBackgroundColor="@color/rentify_card_near_bg"
                                app:cardCornerRadius="23dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="Hóa đơn"
                                    android:src="@drawable/ic_invoice_doc"
                                    app:tint="@color/rentify_primary_gradient_start" />
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Chấm đỏ khi có hóa đơn chưa thanh toán -->
                            <View
                                android:id="@+id/viewInvoiceBadge"
                                android:layout_width="9dp"
                                android:layout_height="9dp"
                                android:layout_gravity="top|end"
                                android:background="@drawable/bg_circle_icon_badge"
                                android:visibility="gone"
                                tools:visibility="visible" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/plus_jakarta_sans_medium"
                            android:text="Hóa đơn"
                            android:textColor="@color/rentify_text_primary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- KHỐI PHÒNG CỦA TÔI (Chỉ hiện khi ĐÃ CÓ PHÒNG) -->
            <FrameLayout
                android:id="@+id/containerMyRoom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:visibility="visible">

                <include
                    android:id="@+id/layoutMyRoom"
                    layout="@layout/view_my_room_card" />
            </FrameLayout>

            <!-- KHỐI KHU VỰC PHỔ BIẾN -->
            <LinearLayout
                android:id="@+id/layoutPopularAreas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="Khu vực phổ biến"
                        android:textColor="@color/rentify_text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnViewAllAreas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:padding="4dp"
                        android:text="Xem tất cả"
                        android:textColor="@color/rentify_primary_gradient_start"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPopularAreas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="6dp" />
            </LinearLayout>

            <!-- KHỐI DÀNH CHO BẠN -->
            <LinearLayout
                android:id="@+id/layoutForYouRooms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:paddingHorizontal="16dp"
                    android:text="Dành cho bạn"
                    android:textColor="@color/rentify_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <!-- Danh sách phòng trọ -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRooms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <!-- Vòng xoay khi tải thêm trang tiếp theo -->
                <ProgressBar
                    android:id="@+id/pbLoadingMore"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginVertical="12dp"
                    android:indeterminateTint="@color/rentify_primary_gradient_start"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- Trạng thái trống (Empty State) -->
                <include
                    android:id="@+id/layoutEmptyState"
                    layout="@layout/view_empty_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="24dp"
                    android:visibility="gone" />

                <!-- Trạng thái lỗi (Error State) -->
                <include
                    android:id="@+id/layoutErrorState"
                    layout="@layout/view_error_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="24dp"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
