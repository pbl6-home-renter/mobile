<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefreshLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rentify_background">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/spacing_lg">

            <!-- HEADER CONTAINER NỀN GRADIENT 135° VUÔNG GÓC HOÀN TOÀN -->
            <FrameLayout
                android:id="@+id/viewHeaderContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_explore_header">

                <!-- Họa tiết đường mái nhà kiến trúc nét mảnh (đẩy lên cao tránh bị thanh search che) -->
                <ImageView
                    android:layout_width="180dp"
                    android:layout_height="90dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="36dp"
                    android:layout_marginBottom="16dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitEnd"
                    android:src="@drawable/bg_header_rooflines" />

                <!-- Container chứa nội dung Text và Button của Header -->
                <FrameLayout
                    android:id="@+id/layoutHeaderContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingLeft="20dp"
                    android:paddingTop="@dimen/spacing_md"
                    android:paddingEnd="20dp"
                    android:paddingRight="20dp"
                    android:paddingBottom="42dp">

                    <!-- Header cho khách (Guest) -->
                    <RelativeLayout
                        android:id="@+id/layoutGuestHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:id="@+id/tvGuestGreeting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:layout_toStartOf="@id/btnGuestLogin"
                            android:layout_marginEnd="@dimen/spacing_md"
                            android:fontFamily="@font/plus_jakarta_sans_medium"
                            android:text="Bạn muốn tìm phòng ở đâu?"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:maxLines="2" />

                        <TextView
                            android:id="@+id/btnGuestLogin"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/bg_btn_pill_glass"
                            android:fontFamily="@font/plus_jakarta_sans_medium"
                            android:gravity="center"
                            android:paddingHorizontal="16dp"
                            android:text="Đăng nhập"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:clickable="true"
                            android:focusable="true" />
                    </RelativeLayout>

                    <!-- Header cho người dùng đã đăng nhập -->
                    <RelativeLayout
                        android:id="@+id/layoutUserHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="visible">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:layout_toStartOf="@id/layoutNotificationContainer"
                            android:layout_marginEnd="@dimen/spacing_md"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvGreetingPrefix"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="Xin chào,"
                                android:textColor="#CCFFFFFF"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvUserName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:fontFamily="@font/plus_jakarta_sans_medium"
                                android:maxLines="1"
                                android:textColor="#FFFFFF"
                                android:textSize="22sp"
                                tools:text="Anh" />

                            <TextView
                                android:id="@+id/tvUserSubGreeting"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="Hôm nay của bạn thế nào?"
                                android:textColor="#DCE7FD"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- Nút Chuông thông báo -->
                        <FrameLayout
                            android:id="@+id/layoutNotificationContainer"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true">

                            <ImageView
                                android:id="@+id/btnNotification"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_circle_glass_button"
                                android:contentDescription="Thông báo"
                                android:scaleType="centerInside"
                                android:src="@drawable/ic_notification"
                                app:tint="#FFFFFF" />

                            <View
                                android:id="@+id/ivNotificationBadge"
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:layout_gravity="top|end"
                                android:layout_marginTop="5dp"
                                android:layout_marginEnd="5dp"
                                android:background="@drawable/bg_notification_dot"
                                android:visibility="gone"
                                tools:visibility="visible" />
                        </FrameLayout>
                    </RelativeLayout>
                </FrameLayout>
            </FrameLayout>

            <!-- THANH TÌM KIẾM ĐÈ MÉP DƯỚI HEADER (NỀN TRẮNG, BO PILL 23DP) -->
            <LinearLayout
                android:id="@+id/layoutSearchBar"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_marginTop="-23dp"
                android:layout_marginEnd="@dimen/spacing_md"
                android:background="@drawable/bg_search_input_pill_white"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_vertical"
                    android:contentDescription="Tìm kiếm"
                    android:src="@drawable/ic_search"
                    app:tint="#9CA3AF" />

                <TextView
                    android:id="@+id/tvSearchQuery"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="Tìm theo tên phòng, khu vực…"
                    android:textColor="#9CA3AF"
                    android:textSize="14sp" />

                <FrameLayout
                    android:id="@+id/btnExploreFilter"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center_vertical"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Lọc phòng"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="Lọc phòng"
                        android:src="@drawable/ic_filter"
                        app:tint="#9CA3AF" />
                </FrameLayout>
            </LinearLayout>

            <!-- 4 TIỆN ÍCH TRÊN KHỐI TRẮNG -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardQuickUtilities"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_md"
                android:layout_marginEnd="@dimen/spacing_md"
                app:cardBackgroundColor="@color/rentify_surface"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="0dp"
                app:strokeColor="#EEF0F3"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/spacing_md">

                    <!-- 1. Tìm gần tôi -->
                    <LinearLayout
                        android:id="@+id/btnUtilNearMe"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/spacing_xs">

                        <FrameLayout
                            android:layout_width="46dp"
                            android:layout_height="46dp">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                app:cardBackgroundColor="#EEF0FF"
                                app:cardCornerRadius="23dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="Tìm gần tôi"
                                    android:src="@drawable/ic_util_location_pin"
                                    app:tint="#595E72" />
                            </com.google.android.material.card.MaterialCardView>
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:fontFamily="@font/plus_jakarta_sans_medium"
                            android:text="Tìm gần tôi"
                            android:textColor="#374151"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- 2. Trọ đã lưu -->
                    <LinearLayout
                        android:id="@+id/btnUtilSavedRooms"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/spacing_xs">

                        <FrameLayout
                            android:layout_width="46dp"
                            android:layout_height="46dp">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                app:cardBackgroundColor="#EEF0FF"
                                app:cardCornerRadius="23dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="Trọ đã lưu"
                                    android:src="@drawable/ic_util_heart_outline"
                                    app:tint="#595E72" />
                            </com.google.android.material.card.MaterialCardView>
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:fontFamily="@font/plus_jakarta_sans_medium"
                            android:text="Trọ đã lưu"
                            android:textColor="#374151"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- 3. Ghép bạn -->
                    <LinearLayout
                        android:id="@+id/btnUtilMatchFriends"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/spacing_xs">

                        <FrameLayout
                            android:layout_width="46dp"
                            android:layout_height="46dp">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                app:cardBackgroundColor="#EEF0FF"
                                app:cardCornerRadius="23dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="Ghép bạn"
                                    android:src="@drawable/ic_util_match_friends"
                                    app:tint="#595E72" />
                            </com.google.android.material.card.MaterialCardView>
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:fontFamily="@font/plus_jakarta_sans_medium"
                            android:text="Ghép bạn"
                            android:textColor="#374151"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- 4. Hóa đơn -->
                    <LinearLayout
                        android:id="@+id/btnUtilInvoices"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/spacing_xs">

                        <FrameLayout
                            android:layout_width="46dp"
                            android:layout_height="46dp">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                app:cardBackgroundColor="#EEF0FF"
                                app:cardCornerRadius="23dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="Hóa đơn"
                                    android:src="@drawable/ic_util_invoice_doc"
                                    app:tint="#595E72" />
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Chấm đỏ khi có hóa đơn chưa thanh toán -->
                            <View
                                android:id="@+id/viewInvoiceBadge"
                                android:layout_width="11dp"
                                android:layout_height="11dp"
                                android:layout_gravity="top|end"
                                android:background="@drawable/bg_invoice_badge"
                                android:visibility="gone"
                                tools:visibility="visible" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:fontFamily="@font/plus_jakarta_sans_medium"
                            android:text="Hóa đơn"
                            android:textColor="#374151"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- KHỐI PHÒNG CỦA TÔI (Chỉ hiện khi ĐÃ CÓ PHÒNG) -->
            <FrameLayout
                android:id="@+id/containerMyRoom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:visibility="gone"
                tools:visibility="visible">

                <include
                    android:id="@+id/layoutMyRoom"
                    layout="@layout/view_my_room_card" />
            </FrameLayout>

            <!-- KHỐI KHU VỰC PHỔ BIẾN -->
            <LinearLayout
                android:id="@+id/layoutPopularAreas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/spacing_md"
                    android:layout_marginBottom="@dimen/spacing_smd">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="Khu vực phổ biến"
                        android:textColor="#161B2C"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnViewAllAreas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:padding="@dimen/spacing_xs"
                        android:text="Xem tất cả"
                        android:textColor="#006876"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPopularAreas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_sm" />
            </LinearLayout>

            <!-- KHỐI TÒA NHÀ NỔI BẬT -->
            <LinearLayout
                android:id="@+id/layoutBuildings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_smd"
                    android:paddingHorizontal="@dimen/spacing_md">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="Tòa nhà nổi bật"
                        android:textColor="#161B2C"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnViewAllBuildings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:padding="@dimen/spacing_xs"
                        android:text="Xem tất cả"
                        android:textColor="#006876"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvBuildings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_sm" />
            </LinearLayout>

            <!-- KHỐI DÀNH CHO BẠN -->
            <LinearLayout
                android:id="@+id/layoutForYouRooms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_smd"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:paddingHorizontal="@dimen/spacing_md"
                    android:text="Dành cho bạn"
                    android:textColor="#161B2C"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Danh sách phòng trọ -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRooms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <!-- Vòng tải lần đầu -->
                <com.rentify.app.tenant.ui.component.TenantLoadingView
                    android:id="@+id/pbLoading"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginVertical="@dimen/spacing_lg"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- Vòng xoay khi tải thêm trang tiếp theo -->
                <com.rentify.app.tenant.ui.component.TenantLoadingView
                    android:id="@+id/pbLoadingMore"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginVertical="@dimen/spacing_xs"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- Trạng thái trống (Empty State) -->
                <include
                    android:id="@+id/layoutEmptyState"
                    layout="@layout/view_empty_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/spacing_lg"
                    android:visibility="gone" />

                <!-- Trạng thái lỗi (Error State) -->
                <include
                    android:id="@+id/layoutErrorState"
                    layout="@layout/view_error_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/spacing_lg"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
