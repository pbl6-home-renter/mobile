<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical"
    android:paddingHorizontal="14dp">

    <include
        android:id="@+id/layoutDateSeparator"
        layout="@layout/layout_message_date_separator" />

    <LinearLayout
        android:id="@+id/bubbleMe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pill_gradient"
        android:orientation="vertical"
        android:paddingHorizontal="13dp"
        android:paddingVertical="9dp">

        <!-- 3.8 Trích dẫn khi trả lời (nằm TRONG bong bóng, phía trên nội dung) -->
        <LinearLayout
            android:id="@+id/layoutReplyQuote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_quote_sent"
            android:orientation="horizontal"
            android:paddingHorizontal="9dp"
            android:paddingVertical="6dp"
            android:visibility="gone"
            tools:visibility="visible">

            <View
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:background="@color/rentify_on_primary"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtReplySender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/rentify_on_primary"
                    android:textSize="12sp"
                    tools:text="Nguyễn Văn A" />

                <TextView
                    android:id="@+id/txtReplyContent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/rentify_on_primary"
                    android:textSize="12sp"
                    tools:text="Vòi xịt nhà tắm bị rỉ" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/txtContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plus_jakarta_sans"
            android:includeFontPadding="false"
            android:textColor="@color/rentify_on_primary"
            android:textSize="14sp"
            tools:text="Dạ em gửi ảnh vòi xịt ạ" />
    </LinearLayout>

    <!-- 3.4 Giờ gửi và trạng thái đã xem (NGAY DƯỚI tin cuối của nhóm hoặc khi chạm vào tin) -->
    <TextView
        android:id="@+id/txtTimeStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="3dp"
        android:fontFamily="@font/plus_jakarta_sans"
        android:includeFontPadding="false"
        android:textColor="@color/rentify_text_faint"
        android:textSize="11sp"
        android:visibility="gone"
        tools:text="09:46, đã xem"
        tools:visibility="visible" />

</LinearLayout>
