<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="4dp">

    <LinearLayout
        android:id="@+id/bubbleMe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="64dp"
        android:background="@drawable/bg_message_me"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp">

        <!-- Quoted message box (hidden by default) -->
        <LinearLayout
            android:id="@+id/layoutReplyQuote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="#20FFFFFF"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:visibility="gone">

            <View
                android:layout_width="2dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:background="#FFFFFF" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtReplySender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:textColor="#E0E7FF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="Nguyễn Văn A" />

                <TextView
                    android:id="@+id/txtReplyContent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:maxLines="1"
                    android:textColor="#F3F4F6"
                    android:textSize="11sp"
                    tools:text="Vòi xịt nhà tắm bị rỉ" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/txtContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plus_jakarta_sans"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            tools:text="Dạ em gửi ảnh vòi xịt ạ" />

        <TextView
            android:id="@+id/txtTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/plus_jakarta_sans"
            android:textColor="#D1E0FF"
            android:textSize="10sp"
            tools:text="11:30" />
    </LinearLayout>

</LinearLayout>

