<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rentify_surface"
    android:orientation="vertical">

    <!-- Top App Bar / Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/rentify_surface"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/rentify_text"
        app:subtitleTextAppearance="@style/TextAppearance.Rentify.ToolbarSubtitle"
        app:title="Phòng đã lưu"
        app:titleTextAppearance="@style/TextAppearance.Rentify.ToolbarTitle" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/rentify_divider" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Main Content: Swipe to Refresh & List -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFavoriteRooms"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/spacing_md"
                android:paddingTop="@dimen/spacing_md"
                android:paddingBottom="@dimen/spacing_lg"
                tools:listitem="@layout/item_favorite_room" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- Loading Indicator -->
        <com.rentify.app.tenant.ui.component.TenantLoadingView
            android:id="@+id/progressBar"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:visibility="gone"
            tools:visibility="gone" />

        <!-- Empty State Container -->
        <LinearLayout
            android:id="@+id/layoutEmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_xl"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:text="Chưa có phòng trọ nào được lưu"
                android:textColor="@color/rentify_text"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:gravity="center"
                android:text="Nhấn biểu tượng trái tim khi xem danh sách phòng để lưu lại và xem lại bất cứ lúc nào."
                android:textColor="@color/rentify_text_muted"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExploreNow"
                style="@style/Widget.Rentify.PillButton"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginTop="18dp"
                android:minHeight="46dp"
                android:paddingHorizontal="@dimen/spacing_xl"
                android:text="Khám phá phòng trọ" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
