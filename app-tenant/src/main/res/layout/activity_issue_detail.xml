<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rentify_background"
    android:orientation="vertical">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/rentify_surface"
        android:elevation="2dp"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/rentify_text_primary"
        app:title="Chi tiết sự cố"
        app:titleTextColor="@color/rentify_text_primary" />

    <!-- Content Area with Loading & Error States -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollViewContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header Card: Status & Title -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/rentify_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/rentify_divider"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvStatusBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_pill_badge_role"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="5dp"
                                android:textColor="@color/rentify_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                tools:text="Chờ tiếp nhận" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <TextView
                                android:id="@+id/tvUrgencyBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                tools:text="● Trung bình" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textColor="@color/rentify_text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:text="Vòi xịt bồn cầu bị rò rỉ nước liên tục" />

                        <TextView
                            android:id="@+id/tvCreatedAt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/rentify_text_secondary"
                            android:textSize="12sp"
                            tools:text="Gửi lúc: 14:30 02/11/2026" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Room & Category Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@color/rentify_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/rentify_divider"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Thông tin khu vực"
                            android:textColor="@color/rentify_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="10dp"
                            android:background="@color/rentify_divider" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:text="Phòng / Tòa nhà:"
                                android:textColor="@color/rentify_text_secondary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvRoomLocation"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="@color/rentify_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                tools:text="Phòng P.201 - Nhà Trọ Hòa Khánh" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:text="Nhóm sự cố:"
                                android:textColor="@color/rentify_text_secondary"
                                android:textSize="13sp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/ivCategoryIcon"
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:contentDescription="Nhóm sự cố"
                                    android:src="@drawable/ic_issue_other"
                                    app:tint="@color/rentify_primary_gradient_start" />

                                <TextView
                                    android:id="@+id/tvCategory"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:textColor="@color/rentify_text_primary"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    tools:text="Đường nước" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layoutReporter"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <TextView
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:text="Người báo cáo:"
                                android:textColor="@color/rentify_text_secondary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvReporterName"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="@color/rentify_text_primary"
                                android:textSize="13sp"
                                tools:text="Nguyễn Văn A" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Description Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@color/rentify_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/rentify_divider"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mô tả sự cố"
                            android:textColor="@color/rentify_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="10dp"
                            android:background="@color/rentify_divider" />

                        <TextView
                            android:id="@+id/tvDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:lineSpacingExtra="4dp"
                            android:textColor="@color/rentify_text_secondary"
                            android:textSize="14sp"
                            tools:text="Vòi xịt bị rỉ nước liên tục từ chiều hôm qua, đã thử vặn chặt van khóa nhưng vẫn không hết, làm ướt sàn nhà tắm." />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Resolution & Assigned Repairer Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardResolution"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/rentify_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/rentify_divider"
                    app:strokeWidth="1dp"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tiến độ &amp; Khắc phục"
                            android:textColor="@color/rentify_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="10dp"
                            android:background="@color/rentify_divider" />

                        <LinearLayout
                            android:id="@+id/layoutAssignedTo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:text="Thợ phụ trách:"
                                android:textColor="@color/rentify_text_secondary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvAssignedTo"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="@color/rentify_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                tools:text="Bác Ba (Thợ nước)" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layoutRepairCost"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <TextView
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:text="Chi phí sửa chữa:"
                                android:textColor="@color/rentify_text_secondary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvRepairCost"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="@color/rentify_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                tools:text="150.000 ₫" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layoutResolutionNote"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="vertical"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ghi chú khắc phục:"
                                android:textColor="@color/rentify_text_secondary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvResolutionNote"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/bg_rounded_surface"
                                android:padding="10dp"
                                android:textColor="@color/rentify_text_primary"
                                android:textSize="13sp"
                                tools:text="Đã thay gioăng cao su và van khóa mới cho vòi xịt." />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layoutClosedAt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <TextView
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:text="Hoàn thành lúc:"
                                android:textColor="@color/rentify_text_secondary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvClosedAt"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="@color/rentify_text_secondary"
                                android:textSize="13sp"
                                tools:text="16:00 03/11/2026" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Loading Indicator -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Bottom Cancel Action Bar (Visible only when status == 'open') -->
    <LinearLayout
        android:id="@+id/layoutBottomAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/rentify_surface"
        android:elevation="8dp"
        android:padding="16dp"
        android:visibility="gone"
        tools:visibility="visible">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelIssue"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Hủy báo cáo sự cố"
            android:textColor="@color/rentify_error"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="25dp"
            app:strokeColor="@color/rentify_error" />
    </LinearLayout>

</LinearLayout>

