<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:minHeight="56dp"
    android:paddingHorizontal="20dp"
    android:paddingVertical="8dp">

    <!-- RentifyAvatarView 40dp -->
    <com.rentify.app.core.ui.view.RentifyAvatarView
        android:id="@+id/memberAvatarView"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:avatarSize="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Cụm Tên + (Bạn) + Nhãn vai trò -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutNameAndRole"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnMessageMember"
        app:layout_constraintStart_toEndOf="@+id/memberAvatarView"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="0dp">

        <TextView
            android:id="@+id/txtMemberName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/plus_jakarta_sans_medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/rentify_text"
            android:textSize="14sp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/txtRoleBadge"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Nguyễn Văn A (Bạn)" />

        <!-- Nhãn vai trò đặc biệt (Trưởng nhóm): 10sp medium, chữ rentify_teal, nền rentify_teal_surface, viền 1dp rentify_teal_border -->
        <TextView
            android:id="@+id/txtRoleBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_landlord_role_badge"
            android:fontFamily="@font/plus_jakarta_sans_medium"
            android:includeFontPadding="false"
            android:paddingHorizontal="7dp"
            android:paddingVertical="2dp"
            android:text="Trưởng nhóm"
            android:textColor="@color/rentify_teal"
            android:textSize="10sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/txtMemberName"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Nút nhắn tin: tròn 40dp, nền rentify_field_bg, icon bong bóng chat 19dp màu #334155, luôn sát mép phải -->
    <ImageButton
        android:id="@+id/btnMessageMember"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_chat_header_icon_btn"
        android:contentDescription="Nhắn tin"
        android:padding="10.5dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_nav_chat"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/rentify_icon_action_slate" />

</androidx.constraintlayout.widget.ConstraintLayout>
