<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical"
    android:paddingHorizontal="14dp">

    <include
        android:id="@+id/layoutDateSeparator"
        layout="@layout/layout_message_date_separator" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardImage"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/rentify_field_bg"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/rentify_border"
        app:strokeWidth="1dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/ivMessageImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Hình ảnh tin nhắn"
                android:scaleType="centerCrop"
                tools:src="@drawable/ic_image_placeholder" />

            <com.rentify.app.tenant.ui.component.TenantLoadingView
                android:id="@+id/pbUploadProgress"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:visibility="gone"
                tools:visibility="visible" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 3.4 Giờ gửi và trạng thái đã xem bên dưới bong bóng ảnh -->
    <TextView
        android:id="@+id/txtTimeStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="3dp"
        android:fontFamily="@font/plus_jakarta_sans"
        android:includeFontPadding="false"
        android:textColor="@color/rentify_text_faint"
        android:textSize="11sp"
        android:visibility="gone"
        tools:text="14:32, đã xem"
        tools:visibility="visible" />

</LinearLayout>
