<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingHorizontal="14dp">

    <include
        android:id="@+id/layoutDateSeparator"
        layout="@layout/layout_message_date_separator" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">

        <!-- Avatar 28dp căn đáy với bong bóng -->
        <FrameLayout
            android:id="@+id/layoutAvatarSlot"
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginEnd="8dp">

            <com.rentify.app.core.ui.view.RentifyAvatarView
                android:id="@+id/avatarSmall"
                android:layout_width="28dp"
                android:layout_height="28dp"
                app:avatarSize="28dp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Tên người gửi phía trên tin ĐẦU của nhóm trong chat nhóm -->
            <TextView
                android:id="@+id/txtSenderName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:includeFontPadding="false"
                android:textColor="@color/rentify_text_muted"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="Nguyễn Văn A"
                tools:visibility="visible" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardImage"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/rentify_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/rentify_border"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/ivMessageImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Hình ảnh tin nhắn"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/ic_image_placeholder" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>

    <!-- 3.4 Giờ gửi ngay dưới tin cuối của nhóm hoặc khi chạm vào tin -->
    <TextView
        android:id="@+id/txtTimeStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginTop="3dp"
        android:fontFamily="@font/plus_jakarta_sans"
        android:includeFontPadding="false"
        android:textColor="@color/rentify_text_faint"
        android:textSize="11sp"
        android:visibility="gone"
        tools:text="14:32"
        tools:visibility="visible" />

</LinearLayout>
