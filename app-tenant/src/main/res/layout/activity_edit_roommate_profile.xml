<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rentify_surface">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/rentify_surface"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarEditProfile"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/rentify_text"
            app:title="Hồ sơ tìm bạn ở của tôi"
            app:titleTextAppearance="@style/TextAppearance.Rentify.ToolbarTitle" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/rentify_divider" />
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="@dimen/spacing_bottom_clearance">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <!-- Visibility Toggle Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/rentify_surface"
                    app:cardCornerRadius="@dimen/radius_lg"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/rentify_border_soft"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/spacing_md">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="Hiển thị công khai"
                                android:textColor="@color/rentify_text"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_2xs"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="Cho phép hồ sơ xuất hiện trên feed tìm bạn ở ghép"
                                android:textColor="@color/rentify_text_muted"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchIsVisible"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Basic Information Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    app:cardBackgroundColor="@color/rentify_surface"
                    app:cardCornerRadius="@dimen/radius_lg"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/rentify_border_soft"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="Thông tin cơ bản"
                            android:textColor="@color/rentify_text"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <!-- Gender -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_smd"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="Giới tính"
                            android:textColor="@color/rentify_text_muted"
                            android:textSize="12sp" />

                        <RadioGroup
                            android:id="@+id/rgGender"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:orientation="horizontal">

                            <RadioButton
                                android:id="@+id/rbMale"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="Nam"
                                android:button="@drawable/sl_radio_light"
                                android:paddingStart="@dimen/spacing_sm"
                                android:textColor="@color/rentify_text"
                                android:textSize="14sp"
                                app:buttonTint="@null"
                                app:useMaterialThemeColors="false" />

                            <RadioButton
                                android:id="@+id/rbFemale"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="Nữ"
                                android:button="@drawable/sl_radio_light"
                                android:paddingStart="@dimen/spacing_sm"
                                android:textColor="@color/rentify_text"
                                android:textSize="14sp"
                                app:buttonTint="@null"
                                app:useMaterialThemeColors="false" />

                            <RadioButton
                                android:id="@+id/rbOther"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="Khác"
                                android:button="@drawable/sl_radio_light"
                                android:paddingStart="@dimen/spacing_sm"
                                android:textColor="@color/rentify_text"
                                android:textSize="14sp"
                                app:buttonTint="@null"
                                app:useMaterialThemeColors="false" />
                        </RadioGroup>

                        <!-- Birth Year -->
                        <com.rentify.app.core.ui.component.RentifyTextField
                            android:id="@+id/edtBirthYear"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_smd"
                            android:inputType="number"
                            app:hint="Năm sinh" />

                        <!-- Occupation -->
                        <com.rentify.app.core.ui.component.RentifyTextField
                            android:id="@+id/edtOccupation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_smd"
                            android:inputType="text"
                            app:hint="Nghề nghiệp / Trường học" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Search Criteria Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    app:cardBackgroundColor="@color/rentify_surface"
                    app:cardCornerRadius="@dimen/radius_lg"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/rentify_border_soft"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="Tiêu chí tìm phòng"
                            android:textColor="@color/rentify_text"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <com.rentify.app.core.ui.component.RentifyTextField
                            android:id="@+id/edtPreferredProvince"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_smd"
                            android:inputType="text"
                            app:hint="Tỉnh / Thành phố" />

                        <com.rentify.app.core.ui.component.RentifyTextField
                            android:id="@+id/edtPreferredDistrict"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_smd"
                            android:inputType="text"
                            app:hint="Phường / Xã" />

                        <!-- Budget Min & Max -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_smd"
                            android:orientation="horizontal">

                            <com.rentify.app.core.ui.component.RentifyTextField
                                android:id="@+id/edtBudgetMin"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/spacing_sm"
                                android:layout_weight="1"
                                android:inputType="number"
                                app:hint="Ngân sách từ" />

                            <com.rentify.app.core.ui.component.RentifyTextField
                                android:id="@+id/edtBudgetMax"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_sm"
                                android:layout_weight="1"
                                android:inputType="number"
                                app:hint="Ngân sách đến" />
                        </LinearLayout>

                        <!-- Move in date -->
                        <com.rentify.app.core.ui.component.RentifyTextField
                            android:id="@+id/edtMoveInOn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_smd"
                            android:inputType="date"
                            app:hint="Ngày dự kiến vào ở" />

                        <!-- Bio -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardBio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_smd"
                            app:cardBackgroundColor="@color/sl_textfield_card_bg"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/sl_textfield_card_stroke"
                            app:strokeWidth="1.5dp">
                        
                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Giới thiệu bản thân"
                                android:textColorHint="@color/rentify_text_muted"
                                app:boxBackgroundColor="@android:color/transparent"
                                app:boxStrokeWidth="0dp"
                                app:boxStrokeWidthFocused="0dp"
                                app:cursorColor="@color/rentify_primary"
                                app:hintTextColor="@color/rentify_primary">
                        
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/edtBio"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@android:color/transparent"
                                    android:fontFamily="@font/plus_jakarta_sans_regular"
                                    android:gravity="top"
                                    android:minLines="3"
                                    android:paddingTop="24dp"
                                    android:paddingBottom="12dp"
                                    android:textColor="@color/rentify_text"
                                    android:textCursorDrawable="@drawable/bg_cursor_primary"
                                    android:textSize="15sp" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Lifestyle & Habits Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    app:cardBackgroundColor="@color/rentify_surface"
                    app:cardCornerRadius="@dimen/radius_lg"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/rentify_border_soft"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="Lối sống và thói quen"
                            android:textColor="@color/rentify_text"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cbCleanAndTidy"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="Ngăn nắp, gọn gàng, sạch sẽ"
                            android:minHeight="44dp"
                            android:paddingStart="@dimen/spacing_sm"
                            android:textColor="@color/rentify_text"
                            android:textSize="14sp"
                            android:button="@drawable/sl_checkbox_light"
                            app:buttonTint="@null"
                                app:useMaterialThemeColors="false" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cbEarlyBird"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="Thức dậy sớm (Early Bird)"
                            android:minHeight="44dp"
                            android:paddingStart="@dimen/spacing_sm"
                            android:textColor="@color/rentify_text"
                            android:textSize="14sp"
                            android:button="@drawable/sl_checkbox_light"
                            app:buttonTint="@null"
                                app:useMaterialThemeColors="false" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cbNightOwl"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="Cú đêm / Thường thức khuya (Night Owl)"
                            android:minHeight="44dp"
                            android:paddingStart="@dimen/spacing_sm"
                            android:textColor="@color/rentify_text"
                            android:textSize="14sp"
                            android:button="@drawable/sl_checkbox_light"
                            app:buttonTint="@null"
                                app:useMaterialThemeColors="false" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cbPetFriendly"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="Thích / Nuôi thú cưng (Pet Friendly)"
                            android:minHeight="44dp"
                            android:paddingStart="@dimen/spacing_sm"
                            android:textColor="@color/rentify_text"
                            android:textSize="14sp"
                            android:button="@drawable/sl_checkbox_light"
                            app:buttonTint="@null"
                                app:useMaterialThemeColors="false" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cbCooking"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="Thường xuyên nấu ăn tại phòng"
                            android:minHeight="44dp"
                            android:paddingStart="@dimen/spacing_sm"
                            android:textColor="@color/rentify_text"
                            android:textSize="14sp"
                            android:button="@drawable/sl_checkbox_light"
                            app:buttonTint="@null"
                                app:useMaterialThemeColors="false" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cbSmoking"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="Có hút thuốc lá"
                            android:minHeight="44dp"
                            android:paddingStart="@dimen/spacing_sm"
                            android:textColor="@color/rentify_text"
                            android:textSize="14sp"
                            android:button="@drawable/sl_checkbox_light"
                            app:buttonTint="@null"
                                app:useMaterialThemeColors="false" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cbGuestsAllowed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="Đồng ý cho bạn bè về phòng"
                            android:minHeight="44dp"
                            android:paddingStart="@dimen/spacing_sm"
                            android:textColor="@color/rentify_text"
                            android:textSize="14sp"
                            android:button="@drawable/sl_checkbox_light"
                            app:buttonTint="@null"
                                app:useMaterialThemeColors="false" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Loading indicator -->
        <com.rentify.app.tenant.ui.component.TenantLoadingView
            android:id="@+id/pbEditLoading"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Bottom Save Button Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/rentify_surface"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/rentify_divider" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveProfile"
                style="@style/Widget.Rentify.PillButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_smd"
                android:layout_marginBottom="@dimen/spacing_md"
                android:text="Lưu hồ sơ" />
        </LinearLayout>
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>

