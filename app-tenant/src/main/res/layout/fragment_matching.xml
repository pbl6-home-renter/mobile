<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rentify_surface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_sm">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/plus_jakarta_sans_medium"
            android:text="Ghép bạn ở cùng"
            android:textColor="@color/rentify_text"
            android:textSize="22sp" />

        <ImageView
            android:id="@+id/btnMyProfile"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_my_room_icon_button"
            android:contentDescription="Hồ sơ của tôi"
            android:padding="10dp"
            android:src="@drawable/ic_user_circle"
            app:tint="@color/rentify_text" />
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutMatching"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="@dimen/spacing_xs"
        android:background="@color/rentify_surface"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/rentify_primary"
        app:tabIndicatorFullWidth="true"
        app:tabIndicatorHeight="2dp"
        app:tabMode="fixed"
        app:tabRippleColor="@null"
        app:tabSelectedTextColor="@color/rentify_text"
        app:tabTextAppearance="@style/RentifyTabTextAppearance"
        app:tabTextColor="@color/rentify_text_muted">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Khám phá bạn ở" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lời mời ghép đôi" />
    </com.google.android.material.tabs.TabLayout>

    <View
        android:id="@+id/dividerTabs"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/rentify_divider" />

    <!-- Main Content Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 1. Explore Tab View -->
        <LinearLayout
            android:id="@+id/layoutExploreTab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/layoutSearchArea"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginHorizontal="18dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:background="@drawable/bg_chat_search_box"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search"
                    app:tint="@color/rentify_text_muted" />

                <EditText
                    android:id="@+id/edtSearchArea"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:hint="Tìm theo khu vực"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:includeFontPadding="false"
                    android:inputType="text"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="@color/rentify_text"
                    android:textColorHint="@color/rentify_text_muted"
                    android:textCursorDrawable="@drawable/bg_cursor_primary"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/btnClearSearch"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="?selectableItemBackgroundBorderless"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_close"
                    android:visibility="gone"
                    app:tint="@color/rentify_text_muted" />
            </LinearLayout>

            <!-- Profile Status Banner (Hidden or No Profile) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProfileBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:visibility="gone"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#FCD34D"
                app:cardBackgroundColor="@color/profile_icon_amber_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_smd"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/ivBannerIcon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_icon_squircle"
                        android:backgroundTint="#FEF3C7"
                        android:padding="@dimen/spacing_sm"
                        android:src="@drawable/ic_visibility_off"
                        app:tint="@color/profile_icon_amber_tint" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_smd"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvBannerTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="Hồ sơ ghép bạn đang tạm ẩn"
                            android:textColor="@color/profile_icon_amber_tint"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvBannerDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_2xs"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="Người khác sẽ không nhìn thấy bạn trên bảng tin tìm bạn ở."
                            android:textColor="@color/rentify_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBannerAction"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:paddingHorizontal="@dimen/spacing_smd"
                        android:backgroundTint="@color/profile_icon_amber_tint"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="Bật lại"
                        android:textColor="@color/rentify_on_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:cornerRadius="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Dedicated Full/Centered Hidden Profile State View (No Card Container) -->
            <LinearLayout
                android:id="@+id/layoutProfileHidden"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/spacing_xl"
                android:paddingVertical="@dimen/spacing_lg"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:gravity="center"
                    android:text="Hồ sơ ghép bạn đang tạm ẩn"
                    android:textColor="@color/rentify_text"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="Người khác sẽ không nhìn thấy bạn trên bảng tin. Bật lại hồ sơ để khám phá và kết nối với các bạn cùng phòng tiềm năng."
                    android:textColor="@color/rentify_text_muted"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEnableProfile"
                    style="@style/Widget.Rentify.PillButton"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:minHeight="46dp"
                    android:paddingHorizontal="@dimen/spacing_xl"
                    android:text="Bật lại hồ sơ" />
            </LinearLayout>

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipeRefreshFeed"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvRoommatesFeed"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingHorizontal="@dimen/spacing_md"
                        android:paddingTop="@dimen/spacing_sm"
                        android:paddingBottom="112dp" />

                    <!-- Empty Feed Layout -->
                    <LinearLayout
                        android:id="@+id/layoutEmptyFeed"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_xl"
                        android:visibility="gone">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans_medium"
                            android:text="Chưa tìm thấy bạn ở ghép phù hợp"
                            android:textColor="@color/rentify_text"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="Hãy thử tìm khu vực khác hoặc hoàn thiện hồ sơ của bạn để tăng độ tương thích AI."
                            android:textColor="@color/rentify_text_muted"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Feed Loading -->
                    <com.rentify.app.tenant.ui.component.TenantLoadingView
                        android:id="@+id/pbFeedLoading"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_gravity="center"
                        android:visibility="gone" />
                </FrameLayout>
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
        </LinearLayout>

        <!-- 2. Match Requests Tab View -->
        <LinearLayout
            android:id="@+id/layoutRequestsTab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Direction Filter Chips (Incoming / Outgoing) -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupDirection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/spacing_md"
                android:paddingVertical="@dimen/spacing_sm"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipIncoming"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:chipCornerRadius="18dp"
                    app:chipStrokeColor="@color/rentify_border"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="Đã nhận"
                    android:textSize="13sp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipOutgoing"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipCornerRadius="18dp"
                    app:chipStrokeColor="@color/rentify_border"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="Đã gửi"
                    android:textSize="13sp" />
            </com.google.android.material.chip.ChipGroup>

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipeRefreshRequests"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvMatchRequests"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingHorizontal="@dimen/spacing_md"
                        android:paddingTop="@dimen/spacing_sm"
                        android:paddingBottom="112dp" />

                    <!-- Empty Requests Layout -->
                    <LinearLayout
                        android:id="@+id/layoutEmptyRequests"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_xl"
                        android:visibility="gone">


                        <TextView
                            android:id="@+id/tvEmptyRequestsTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans_medium"
                            android:text="Chưa có lời mời ghép đôi nào"
                            android:textColor="@color/rentify_text"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/tvEmptyRequestsDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="Khi có người gửi lời mời ghép đôi tới bạn, danh sách sẽ hiển thị tại đây."
                            android:textColor="@color/rentify_text_muted"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Requests Loading -->
                    <com.rentify.app.tenant.ui.component.TenantLoadingView
                        android:id="@+id/pbRequestsLoading"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_gravity="center"
                        android:visibility="gone" />
                </FrameLayout>
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
        </LinearLayout>

        <!-- 3. Guest Layout (Chưa đăng nhập) -->
        <LinearLayout
            android:id="@+id/layoutGuest"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_xl"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="80dp"
                android:layout_height="80dp"
                app:cardBackgroundColor="#102563EB"
                app:cardCornerRadius="40dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/rentify_primary_gradient_start"
                app:strokeWidth="1.5dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_nav_matching"
                    app:tint="@color/rentify_primary_gradient_start" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_ml"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Chưa đăng nhập"
                android:textColor="@color/rentify_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:gravity="center"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Đăng nhập để xem danh sách bạn ở ghép tương thích và gửi lời mời kết nối."
                android:textColor="@color/rentify_text_secondary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuestLogin"
                style="@style/Widget.Rentify.PillButton"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginTop="@dimen/spacing_lg"
                android:minHeight="46dp"
                android:paddingHorizontal="@dimen/spacing_xl"
                android:text="Đăng nhập ngay" />
        </LinearLayout>

    </FrameLayout>
</LinearLayout>
