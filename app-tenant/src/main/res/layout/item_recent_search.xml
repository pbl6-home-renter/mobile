<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="0dp">

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:contentDescription="Lịch sử tìm kiếm"
        android:src="@drawable/ic_clock"
        app:tint="@color/rentify_icon_gray" />

    <TextView
        android:id="@+id/tvRecentKeyword"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/plus_jakarta_sans"
        android:maxLines="1"
        android:textColor="@color/rentify_chip_text"
        android:textSize="15sp"
        tools:text="Phòng trọ gần Bách Khoa" />

    <FrameLayout
        android:id="@+id/btnRemoveRecent"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="Xóa tìm kiếm này"
        android:focusable="true">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:contentDescription="Xóa"
            android:src="@drawable/ic_close"
            app:tint="@color/rentify_icon_gray" />
    </FrameLayout>

</LinearLayout>
