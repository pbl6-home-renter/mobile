<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_rounded_surface"
    android:orientation="vertical"
    android:padding="@dimen/spacing_ml">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/plus_jakarta_sans_medium"
        android:text="Đổi mật khẩu"
        android:textColor="@color/rentify_text"
        android:textSize="18sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:fontFamily="@font/plus_jakarta_sans"
        android:text="Vui lòng nhập mật khẩu hiện tại và mật khẩu mới"
        android:textColor="@color/rentify_text_secondary"
        android:textSize="13sp" />

    <com.rentify.app.core.ui.component.RentifyTextField
        android:id="@+id/etCurrentPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_ml"
        android:inputType="textPassword"
        app:hint="Mật khẩu hiện tại"
        app:isPassword="true" />

    <com.rentify.app.core.ui.component.RentifyTextField
        android:id="@+id/etNewPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:inputType="textPassword"
        app:hint="Mật khẩu mới"
        app:isPassword="true" />

    <com.rentify.app.core.ui.component.RentifyTextField
        android:id="@+id/etConfirmPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:inputType="textPassword"
        app:hint="Xác nhận mật khẩu mới"
        app:isPassword="true" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSubmitChangePassword"
        style="@style/Widget.Rentify.PillButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="@dimen/spacing_ml"
        android:text="Cập nhật mật khẩu" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelChangePassword"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="@dimen/spacing_sm"
        android:fontFamily="@font/plus_jakarta_sans"
        android:text="Hủy bỏ"
        android:textColor="@color/rentify_text_secondary"
        android:textSize="14sp" />
</LinearLayout>
