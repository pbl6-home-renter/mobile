<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefreshLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rentify_background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="40dp">

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Tài khoản"
                android:textColor="@color/rentify_text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Thông tin cá nhân &amp; cài đặt ứng dụng"
                android:textColor="@color/rentify_text_secondary"
                android:textSize="13sp" />

            <!-- Loading Indicator -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:visibility="gone" />

            <!-- GUEST STATE CONTAINER -->
            <LinearLayout
                android:id="@+id/layoutGuestMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                tools:visibility="gone">

                <!-- Guest Login Banner Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardBackgroundColor="@color/rentify_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/rentify_divider"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <ImageView
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:background="@drawable/bg_circle_icon_button"
                            android:padding="14dp"
                            android:src="@drawable/ic_user_circle"
                            app:tint="@color/rentify_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="Bạn chưa đăng nhập"
                            android:textColor="@color/rentify_text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="Đăng nhập để xem thông tin phòng thuê, hợp đồng và hóa đơn của bạn"
                            android:textColor="@color/rentify_text_secondary"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnGuestLogin"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="18dp"
                            android:background="@drawable/bg_button_gradient"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="Đăng nhập ngay"
                            android:textColor="@color/rentify_on_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:backgroundTint="@null"
                            app:cornerRadius="14dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Guest System Settings Card -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="Cài đặt &amp; Trợ giúp"
                    android:textColor="@color/rentify_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="@color/rentify_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/rentify_divider"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/btnGuestDevTweaks"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp">

                            <FrameLayout
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:background="@drawable/bg_icon_squircle"
                                android:backgroundTint="@color/profile_icon_neutral_bg">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_wrench_tool"
                                    app:tint="@color/profile_icon_neutral_tint" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="Developer Tweaks"
                                android:textColor="@color/rentify_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="@color/rentify_text_secondary" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="64dp"
                            android:background="@color/rentify_divider" />

                        <LinearLayout
                            android:id="@+id/btnGuestTerms"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp">

                            <FrameLayout
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:background="@drawable/bg_icon_squircle"
                                android:backgroundTint="@color/profile_icon_indigo_bg">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_shield_info"
                                    app:tint="@color/profile_icon_indigo_tint" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="Điều khoản &amp; Chính sách bảo mật"
                                android:textColor="@color/rentify_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="@color/rentify_text_secondary" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- LOGGED-IN STATE CONTAINER -->
            <LinearLayout
                android:id="@+id/layoutLoggedInMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                tools:visibility="visible">

                <!-- 1. Seamless User Info Header (No Box Card) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Avatar Letter Circle -->
                    <FrameLayout
                        android:layout_width="70dp"
                        android:layout_height="70dp">

                        <ImageView
                            android:id="@+id/ivAvatar"
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:background="@drawable/bg_avatar_gradient"
                            android:scaleType="centerCrop" />

                        <TextView
                            android:id="@+id/tvAvatarLetter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:textColor="@color/rentify_on_primary"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            tools:text="D" />
                    </FrameLayout>

                    <!-- User Name & Email & Actions -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvUserName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:maxLines="1"
                            android:textColor="@color/rentify_text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:text="Dennis Connelly" />

                        <TextView
                            android:id="@+id/tvUserEmail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:maxLines="1"
                            android:textColor="@color/rentify_text_secondary"
                            android:textSize="13sp"
                            tools:text="Parker_Larkin@yahoo.com" />

                        <!-- Role Badge & Quick Edit Button Row -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_pill_badge_role"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp">

                                <TextView
                                    android:id="@+id/tvUserRoleBadge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:textColor="@color/rentify_primary"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    tools:text="Người thuê trọ" />
                            </LinearLayout>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/btnQuickEditProfile"
                                android:layout_width="wrap_content"
                                android:layout_height="26dp"
                                android:layout_marginStart="8dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardBackgroundColor="#102563EB"
                                app:cardCornerRadius="8dp"
                                app:cardElevation="0dp"
                                app:rippleColor="#202563EB"
                                app:strokeWidth="0dp">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingHorizontal="8dp">

                                    <ImageView
                                        android:layout_width="12dp"
                                        android:layout_height="12dp"
                                        android:src="@drawable/ic_edit_pencil"
                                        app:tint="@color/rentify_primary_gradient_start" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="4dp"
                                        android:fontFamily="@font/plus_jakarta_sans"
                                        android:includeFontPadding="false"
                                        android:text="Chỉnh sửa"
                                        android:textColor="@color/rentify_primary_gradient_start"
                                        android:textSize="11sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- 2. Section 1: Tài khoản & Tiện ích -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="Tài khoản &amp; Tiện ích"
                    android:textColor="@color/rentify_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="@color/rentify_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/rentify_divider"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Số điện thoại Row -->
                        <LinearLayout
                            android:id="@+id/btnEditProfileRow"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp">

                            <FrameLayout
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:background="@drawable/bg_icon_squircle"
                                android:backgroundTint="@color/profile_icon_blue_bg">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_phone"
                                    app:tint="@color/profile_icon_blue_tint" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="Số điện thoại"
                                android:textColor="@color/rentify_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvUserPhone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:textColor="@color/rentify_text_secondary"
                                android:textSize="13sp"
                                tools:text="0599965927" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="@color/rentify_text_secondary" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="64dp"
                            android:background="@color/rentify_divider" />

                        <!-- Đổi mật khẩu Row -->
                        <LinearLayout
                            android:id="@+id/btnChangePasswordRow"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp">

                            <FrameLayout
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:background="@drawable/bg_icon_squircle"
                                android:backgroundTint="@color/profile_icon_indigo_bg">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_lock_reset"
                                    app:tint="@color/profile_icon_indigo_tint" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="Đổi mật khẩu"
                                android:textColor="@color/rentify_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="@color/rentify_text_secondary" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="64dp"
                            android:background="@color/rentify_divider" />

                        <!-- Phòng trọ đã lưu Row -->
                        <LinearLayout
                            android:id="@+id/btnFavoriteRooms"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp">

                            <FrameLayout
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:background="@drawable/bg_icon_squircle"
                                android:backgroundTint="@color/profile_icon_rose_bg">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_heart_filled"
                                    app:tint="@color/profile_icon_rose_tint" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="Phòng trọ đã lưu"
                                android:textColor="@color/rentify_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="@color/rentify_text_secondary" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="64dp"
                            android:background="@color/rentify_divider" />

                        <!-- Cài đặt thông báo Row -->
                        <LinearLayout
                            android:id="@+id/btnNotifications"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp">

                            <FrameLayout
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:background="@drawable/bg_icon_squircle"
                                android:backgroundTint="@color/profile_icon_amber_bg">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_notification"
                                    app:tint="@color/profile_icon_amber_tint" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="Cài đặt thông báo"
                                android:textColor="@color/rentify_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="@color/rentify_text_secondary" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. Section 2: Hệ thống & Trợ giúp -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="Hệ thống &amp; Trợ giúp"
                    android:textColor="@color/rentify_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="@color/rentify_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/rentify_divider"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Developer Tweaks Row -->
                        <LinearLayout
                            android:id="@+id/btnDevTweaksRow"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp">

                            <FrameLayout
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:background="@drawable/bg_icon_squircle"
                                android:backgroundTint="@color/profile_icon_neutral_bg">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_wrench_tool"
                                    app:tint="@color/profile_icon_neutral_tint" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="Developer Tweaks"
                                android:textColor="@color/rentify_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_pill_badge_role"
                                android:backgroundTint="#F1F5F9"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="2dp"
                                android:text="Dev"
                                android:textColor="@color/rentify_text_secondary"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="@color/rentify_text_secondary" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="64dp"
                            android:background="@color/rentify_divider" />

                        <!-- Điều khoản & Chính sách Row -->
                        <LinearLayout
                            android:id="@+id/btnTermsRow"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp">

                            <FrameLayout
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:background="@drawable/bg_icon_squircle"
                                android:backgroundTint="@color/profile_icon_indigo_bg">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_shield_info"
                                    app:tint="@color/profile_icon_indigo_tint" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="Điều khoản &amp; Chính sách bảo mật"
                                android:textColor="@color/rentify_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="@color/rentify_text_secondary" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="64dp"
                            android:background="@color/rentify_divider" />

                        <!-- App Version Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp">

                            <FrameLayout
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:background="@drawable/bg_icon_squircle"
                                android:backgroundTint="@color/profile_icon_neutral_bg">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_shield_info"
                                    app:tint="@color/profile_icon_neutral_tint" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="Phiên bản ứng dụng"
                                android:textColor="@color/rentify_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="v1.0.0 (Tenant)"
                                android:textColor="@color/rentify_neutral"
                                android:textSize="12sp" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 4. Logout Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogout"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="28dp"
                    android:backgroundTint="@color/profile_logout_bg"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="Đăng xuất"
                    android:textColor="@color/profile_logout_text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="14dp"
                    app:elevation="0dp"
                    app:icon="@drawable/ic_logout"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/profile_logout_text"
                    app:strokeWidth="0dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>