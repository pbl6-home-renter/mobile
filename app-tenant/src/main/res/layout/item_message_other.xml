<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingHorizontal="14dp">

    <include
        android:id="@+id/layoutDateSeparator"
        layout="@layout/layout_message_date_separator" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">

        <!-- 3.3 Avatar RentifyAvatarView 28dp (chỉ hiện ở tin CUỐI của nhóm trong chat nhóm, căn đáy với bong bóng) -->
        <FrameLayout
            android:id="@+id/layoutAvatarSlot"
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginEnd="8dp">

            <com.rentify.app.core.ui.view.RentifyAvatarView
                android:id="@+id/avatarSmall"
                android:layout_width="28dp"
                android:layout_height="28dp"
                app:avatarSize="28dp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Tên người gửi phía trên tin ĐẦU của nhóm tin trong chat nhóm (12sp, rentify_text_muted) -->
            <TextView
                android:id="@+id/txtSenderName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:includeFontPadding="false"
                android:textColor="@color/rentify_text_muted"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="Nguyễn Văn A"
                tools:visibility="visible" />

            <!-- Bong bóng tin nhận -->
            <LinearLayout
                android:id="@+id/bubbleOther"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="13dp"
                android:paddingVertical="9dp">

                <!-- 3.8 Trích dẫn khi trả lời (nằm TRONG bong bóng, phía trên nội dung) -->
                <LinearLayout
                    android:id="@+id/layoutReplyQuote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/bg_quote_received"
                    android:orientation="horizontal"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="6dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <View
                        android:layout_width="3dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="8dp"
                        android:background="@color/rentify_primary"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtReplySender"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/plus_jakarta_sans_medium"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="@color/rentify_text"
                            android:textSize="12sp"
                            tools:text="Nguyễn Văn A" />

                        <TextView
                            android:id="@+id/txtReplyContent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="@color/rentify_text_secondary"
                            android:textSize="12sp"
                            tools:text="Vòi xịt nhà tắm bị rỉ" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/txtContent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:includeFontPadding="false"
                    android:textColor="@color/rentify_text"
                    android:textSize="14sp"
                    tools:text="Chào bạn, phòng 305 còn trống nhé!" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 3.4 Giờ gửi ngay dưới tin cuối của nhóm hoặc khi chạm vào tin -->
    <TextView
        android:id="@+id/txtTimeStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginTop="3dp"
        android:fontFamily="@font/plus_jakarta_sans"
        android:includeFontPadding="false"
        android:textColor="@color/rentify_text_faint"
        android:textSize="11sp"
        android:visibility="gone"
        tools:text="11:32"
        tools:visibility="visible" />

</LinearLayout>
