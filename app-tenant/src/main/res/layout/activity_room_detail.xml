<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rentify_surface">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/rentify_surface"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/layoutScrollInner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/rentify_surface"
            android:orientation="vertical">

            <!-- 2. Ảnh (ViewPager2 cao 300dp, centerCrop) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="300dp">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/vpImageSlider"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Chỉ số ảnh: các chấm ở giữa, cách đáy ảnh 34dp -->
                <LinearLayout
                    android:id="@+id/layoutDotsIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="34dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />

                <!-- Nút trên ảnh (quay lại góc trái; chia sẻ và yêu thích góc phải, cách nhau 8dp) -->
                <RelativeLayout
                    android:id="@+id/layoutTopOverlayBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:paddingHorizontal="14dp"
                    android:paddingTop="34dp">

                    <ImageButton
                        android:id="@+id/btnBack"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_alignParentStart="true"
                        android:background="@drawable/bg_room_detail_overlay_btn"
                        android:contentDescription="Quay lại"
                        android:padding="9dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_chevron_left"
                        app:tint="@color/rentify_text" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/btnShare"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_room_detail_overlay_btn"
                            android:contentDescription="Chia sẻ"
                            android:padding="9.5dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_share_2"
                            app:tint="@color/rentify_text" />

                        <ImageButton
                            android:id="@+id/btnFavorite"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_room_detail_overlay_btn"
                            android:contentDescription="Lưu phòng"
                            android:padding="9.5dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_heart_outline"
                            app:tint="@color/rentify_text" />
                    </LinearLayout>
                </RelativeLayout>
            </FrameLayout>

            <!-- Khối nội dung bo góc trên 24dp, nền trắng, margin top -22dp, padding ngang 18dp, top 22dp, bottom 104dp -->
            <LinearLayout
                android:id="@+id/layoutContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-22dp"
                android:background="@drawable/bg_room_detail_content_sheet"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingTop="22dp"
                android:paddingBottom="104dp">

                <!-- 3. Trạng thái, tên, địa chỉ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvRoomStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_room_status_available"
                        android:fontFamily="@font/plus_jakarta_sans_medium"
                        android:includeFontPadding="false"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="@string/room_status_available"
                        android:textColor="@color/rentify_teal"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvPostedAgo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:includeFontPadding="false"
                        android:textColor="@color/rentify_text_muted"
                        android:textSize="12sp"
                        android:visibility="gone"
                        tools:text="Đăng 3 ngày trước"
                        tools:visibility="visible" />
                </LinearLayout>

                <!-- Tên phòng: 21sp medium, rentify_text, margin top 12dp, tối đa 2 dòng -->
                <TextView
                    android:id="@+id/tvRoomTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:textColor="@color/rentify_text"
                    android:textSize="23sp"
                    tools:text="Phòng P.201" />

                <!-- Địa chỉ: icon định vị 15dp + chữ 13sp rentify_text_muted, margin top 6dp -->
                <LinearLayout
                    android:id="@+id/layoutRoomAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_location_pin"
                        app:tint="@color/rentify_text_muted" />

                    <TextView
                        android:id="@+id/tvRoomAddress"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:includeFontPadding="false"
                        android:maxLines="2"
                        android:textColor="@color/rentify_text_muted"
                        android:textSize="13sp"
                        tools:text="122 Nguyễn Lương Bằng, Liên Chiểu, Đà Nẵng" />
                </LinearLayout>

                <!-- 4. Thông số (Lưới 2x2, khoảng cách 8dp, margin top 18dp) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="vertical">

                    <!-- Hàng 1: Diện tích + Tầng -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <!-- Ô 1: Diện tích -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_room_spec_card"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="12dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_spec_area"
                                app:tint="@color/rentify_icon_slate" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:includeFontPadding="false"
                                    android:text="Diện tích"
                                    android:textColor="@color/rentify_text_muted"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/tvSpecArea"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:ellipsize="end"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:textStyle="bold"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:textColor="@color/rentify_text"
                                    android:textSize="16sp"
                                    tools:text="25 m²" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Ô 2: Tầng -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_room_spec_card"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="12dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_spec_floor"
                                app:tint="@color/rentify_icon_slate" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:includeFontPadding="false"
                                    android:text="Tầng"
                                    android:textColor="@color/rentify_text_muted"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/tvSpecFloor"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:ellipsize="end"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:textStyle="bold"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:textColor="@color/rentify_text"
                                    android:textSize="16sp"
                                    tools:text="2" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Hàng 2: Tối đa + Giới tính (cách hàng trên 8dp) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <!-- Ô 3: Tối đa -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_room_spec_card"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="12dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_group"
                                app:tint="@color/rentify_icon_slate" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:includeFontPadding="false"
                                    android:text="Tối đa"
                                    android:textColor="@color/rentify_text_muted"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/tvSpecOccupancy"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:ellipsize="end"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:textStyle="bold"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:textColor="@color/rentify_text"
                                    android:textSize="16sp"
                                    tools:text="2 người" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Ô 4: Giới tính -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_room_spec_card"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="12dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_user_outline"
                                app:tint="@color/rentify_icon_slate" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:includeFontPadding="false"
                                    android:text="Giới tính"
                                    android:textColor="@color/rentify_text_muted"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/tvSpecGender"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:ellipsize="end"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:textStyle="bold"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:textColor="@color/rentify_text"
                                    android:textSize="16sp"
                                    tools:text="Nam, Nữ" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- 5. Tiện nghi (ẩn cả mục nếu không có tiện nghi nào) -->
                <LinearLayout
                    android:id="@+id/layoutAmenitiesSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:layout_marginBottom="12dp"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:textStyle="bold"
                        android:includeFontPadding="false"
                        android:text="Tiện nghi"
                        android:textColor="@color/rentify_text"
                        android:textSize="18sp" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupAmenities"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="8dp"
                        app:chipSpacingVertical="8dp" />
                </LinearLayout>

                <!-- 6. Điện và nước -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:text="Điện và nước"
                    android:textColor="@color/rentify_text"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_room_spec_card"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:includeFontPadding="false"
                            android:text="Tiền điện"
                            android:textColor="@color/rentify_text_secondary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvElectricityPolicy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:textStyle="bold"
                            android:includeFontPadding="false"
                            android:textColor="@color/rentify_text"
                            android:textSize="14sp"
                            tools:text="Theo công tơ" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/rentify_soft_divider"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:includeFontPadding="false"
                            android:text="Tiền nước"
                            android:textColor="@color/rentify_text_secondary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvWaterPolicy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:textStyle="bold"
                            android:includeFontPadding="false"
                            android:textColor="@color/rentify_text"
                            android:textSize="14sp"
                            tools:text="Theo khối tiêu thụ" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 7. Mô tả -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:text="Mô tả"
                    android:textColor="@color/rentify_text"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:lineSpacingMultiplier="1.4"
                    android:maxLines="4"
                    android:textColor="@color/rentify_text_body"
                    android:textSize="14sp"
                    tools:text="Phòng trọ rộng rãi, thoáng mát, ban công hướng đông đón nắng sớm. Đầy đủ tiện nghi cơ bản, an ninh 24/7, camera giám sát toàn khu vực tòa nhà." />

                <TextView
                    android:id="@+id/btnToggleDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:includeFontPadding="false"
                    android:paddingVertical="4dp"
                    android:text="Xem thêm"
                    android:textColor="@color/rentify_primary"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- 7b. Chủ trọ -->
                <TextView
                    android:id="@+id/tvLandlordSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:text="Chủ trọ"
                    android:textColor="@color/rentify_text"
                    android:textSize="18sp" />

                <LinearLayout
                    android:id="@+id/layoutLandlordCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_room_landlord_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="12dp">

                    <com.rentify.app.core.ui.view.RentifyAvatarView
                        android:id="@+id/landlordAvatarView"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        app:avatarSize="46dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvLandlordName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:textStyle="bold"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="@color/rentify_text"
                            android:textSize="16sp"
                            tools:text="Nguyễn Văn A" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:includeFontPadding="false"
                            android:text="Chủ trọ"
                            android:textColor="@color/rentify_text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnCallLandlord"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_room_landlord_call_btn"
                        android:contentDescription="Gọi chủ trọ"
                        android:padding="11.5dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_phone_outline"
                        app:tint="@color/rentify_icon_action_slate" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 8. Thanh nổi dưới cùng (cố định ở đáy, margin trái/phải 12dp, đáy 14dp, cao 64dp) -->
    <LinearLayout
        android:id="@+id/layoutBottomBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_chat_input_bar_pill"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="8dp">

        <!-- Trái: Giá /tháng + Cọc -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvBottomRentPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="@color/rentify_teal"
                    android:textSize="18sp"
                    tools:text="2.400.000 đ" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text=" /tháng"
                    android:textColor="@color/rentify_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvBottomDepositAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/plus_jakarta_sans"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="@color/rentify_text_muted"
                android:textSize="11sp"
                tools:text="Cọc 2.400.000 đ" />
        </LinearLayout>

        <!-- Phải: Nút "Nhắn tin" dùng style Widget.Rentify.PillButton, cao 48dp -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBottomChatLandlord"
            style="@style/Widget.Rentify.PillButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:paddingHorizontal="20dp"
            android:text="Nhắn tin"
            app:icon="@drawable/ic_nav_chat" />
    </LinearLayout>

    <!-- Loading Indicator -->
    <com.rentify.app.tenant.ui.component.TenantLoadingView
        android:id="@+id/progressBar"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Error Layout -->
    <include
        android:id="@+id/layoutError"
        layout="@layout/view_error_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
