<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefreshLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rentify_background">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Guest State -->
        <LinearLayout
            android:id="@+id/layoutGuest"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_xl"
            android:visibility="gone"
            tools:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="80dp"
                android:layout_height="80dp"
                app:cardBackgroundColor="#102563EB"
                app:cardCornerRadius="40dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/rentify_primary_gradient_start"
                app:strokeWidth="1.5dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_nav_my_room"
                    app:tint="@color/rentify_primary_gradient_start" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_ml"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Chưa đăng nhập"
                android:textColor="@color/rentify_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:gravity="center"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Vui lòng đăng nhập để theo dõi hợp đồng, hóa đơn và yêu cầu sửa chữa phòng của bạn."
                android:textColor="@color/rentify_text_secondary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuestLogin"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="@dimen/spacing_lg"
                android:backgroundTint="@color/rentify_primary_gradient_start"
                android:fontFamily="@font/plus_jakarta_sans"
                android:paddingHorizontal="@dimen/spacing_28"
                android:text="Đăng nhập ngay"
                android:textColor="@color/rentify_on_primary"
                android:textSize="14sp"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <!-- No Room State -->
        <LinearLayout
            android:id="@+id/layoutNoRoom"
            android:background="@color/rentify_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:paddingHorizontal="16dp"
                android:paddingTop="22dp"
                android:text="@string/my_rooms_title"
                android:textColor="@color/rentify_text"
                android:textSize="22sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/spacing_xl"
                android:paddingBottom="@dimen/spacing_hero">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:text="@string/my_rooms_empty_active_title"
                    android:textColor="@color/rentify_text"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:gravity="center"
                    android:text="@string/my_rooms_empty_active_desc"
                    android:textColor="@color/rentify_text_muted"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExploreRooms"
                    style="@style/Widget.Rentify.PillButton"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginTop="18dp"
                    android:minHeight="46dp"
                    android:paddingHorizontal="@dimen/spacing_xl"
                    android:text="@string/my_rooms_find_room"
                    app:icon="@drawable/ic_search" />
            </LinearLayout>
        </LinearLayout>

        <!-- Error State -->
        <include
            android:id="@+id/layoutError"
            layout="@layout/view_error_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            tools:visibility="gone" />

        <!-- Active Room Dashboard -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/layoutActiveRoom"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/rentify_surface"
            android:fillViewport="true"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="112dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_my_room_header"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="22dp"
                    android:paddingBottom="64dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:fontFamily="@font/plus_jakarta_sans_medium"
                            android:text="@string/my_rooms_title"
                            android:textColor="@color/rentify_on_primary"
                            android:textSize="22sp" />

                        <ImageView
                            android:id="@+id/btnViewAllContracts"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_alignParentEnd="true"
                            android:background="@drawable/bg_my_room_header_button"
                            android:clickable="true"
                            android:contentDescription="@string/my_room_all_rooms"
                            android:focusable="true"
                            android:padding="10dp"
                            android:src="@drawable/ic_layout_list"
                            app:tint="@color/rentify_on_primary" />
                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivRoomCover"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@color/rentify_skeleton_light"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Rentify.RoomThumb" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvRoomTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="@font/plus_jakarta_sans_medium"
                                android:maxLines="1"
                                android:textColor="@color/rentify_on_primary"
                                android:textSize="17sp"
                                tools:text="Phòng 305" />

                            <TextView
                                android:id="@+id/tvRoomBuilding"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:alpha="0.85"
                                android:ellipsize="end"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:maxLines="1"
                                android:textColor="@color/rentify_on_primary"
                                android:textSize="13sp"
                                tools:text="Nhà trọ An Bình" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCurrentInvoice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="-44dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/rentify_surface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="6dp"
                    app:strokeColor="@color/rentify_border_soft"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:id="@+id/layoutInvoicePending"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <TextView
                                    android:id="@+id/tvInvoicePeriod"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:textColor="@color/rentify_text_muted"
                                    android:textSize="12sp"
                                    tools:text="Hóa đơn tháng 10" />

                                <TextView
                                    android:id="@+id/tvInvoiceDueDate"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:fontFamily="@font/plus_jakarta_sans_medium"
                                    android:textColor="@color/rentify_warning_text"
                                    android:textSize="12sp"
                                    tools:text="Hạn 05/11" />
                            </RelativeLayout>

                            <TextView
                                android:id="@+id/tvInvoiceAmount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/plus_jakarta_sans_semibold"
                                android:textColor="@color/rentify_text"
                                android:textSize="24sp"
                                tools:text="3.850.000 đ" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnPayVietQr"
                                    style="@style/Widget.Rentify.PillButton"
                                    android:layout_width="0dp"
                                    android:layout_height="46dp"
                                    android:layout_weight="1"
                                    android:minHeight="46dp"
                                    android:text="@string/my_room_pay_qr"
                                    app:icon="@drawable/ic_qr_code" />

                                <ImageView
                                    android:id="@+id/btnInvoiceHistory"
                                    android:layout_width="46dp"
                                    android:layout_height="46dp"
                                    android:layout_marginStart="10dp"
                                    android:background="@drawable/bg_my_room_icon_button"
                                    android:clickable="true"
                                    android:contentDescription="@string/my_room_invoice_history"
                                    android:focusable="true"
                                    android:padding="13dp"
                                    android:src="@drawable/ic_history"
                                    app:tint="@color/rentify_icon_slate" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layoutInvoiceSettled"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <ImageView
                                android:id="@+id/ivInvoiceSettledIcon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_receipt"
                                app:tint="@color/rentify_teal" />

                            <TextView
                                android:id="@+id/tvInvoiceSettledText"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/plus_jakarta_sans_medium"
                                android:textColor="@color/rentify_teal"
                                android:textSize="14sp"
                                tools:text="Đã thanh toán hóa đơn tháng 10" />

                            <ImageView
                                android:id="@+id/btnInvoiceHistorySettled"
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:layout_marginStart="10dp"
                                android:background="@drawable/bg_my_room_icon_button"
                                android:clickable="true"
                                android:contentDescription="@string/my_room_invoice_history"
                                android:focusable="true"
                                android:padding="13dp"
                                android:src="@drawable/ic_history"
                                app:tint="@color/rentify_icon_slate" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <LinearLayout
                        android:id="@+id/actionContract"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingVertical="4dp">

                        <ImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_my_room_action_circle"
                            android:importantForAccessibility="no"
                            android:padding="17dp"
                            android:src="@drawable/ic_file_text"
                            app:tint="@color/profile_icon_neutral_tint" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="@string/my_room_action_contract"
                            android:textColor="@color/rentify_text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/actionIssues"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingVertical="4dp">

                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">

                            <ImageView
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:background="@drawable/bg_my_room_action_circle"
                                android:importantForAccessibility="no"
                                android:padding="17dp"
                                android:src="@drawable/ic_wrench_tool"
                                app:tint="@color/profile_icon_neutral_tint" />

                            <TextView
                                android:id="@+id/tvIssuesBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="16dp"
                                android:layout_gravity="top|end"
                                android:background="@drawable/bg_unread_badge"
                                android:fontFamily="@font/plus_jakarta_sans_medium"
                                android:gravity="center"
                                android:minWidth="16dp"
                                android:paddingHorizontal="4dp"
                                android:textColor="@color/rentify_on_primary"
                                android:textSize="10sp"
                                android:visibility="gone"
                                tools:text="2"
                                tools:visibility="visible" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="@string/my_room_action_issues"
                            android:textColor="@color/rentify_text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/actionInvoices"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingVertical="4dp">

                        <ImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_my_room_action_circle"
                            android:importantForAccessibility="no"
                            android:padding="17dp"
                            android:src="@drawable/ic_receipt_text"
                            app:tint="@color/profile_icon_neutral_tint" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="@string/my_room_action_invoices"
                            android:textColor="@color/rentify_text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPeopleTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:paddingHorizontal="16dp"
                    android:text="@string/my_room_people_title"
                    android:textColor="@color/rentify_text"
                    android:textSize="16sp" />

                <LinearLayout
                    android:id="@+id/layoutLandlordRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="10dp">

                    <com.rentify.app.core.ui.view.RentifyAvatarView
                        android:id="@+id/landlordAvatarView"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        app:avatarSize="44dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvLandlordName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/plus_jakarta_sans_medium"
                            android:maxLines="1"
                            android:textColor="@color/rentify_text"
                            android:textSize="14sp"
                            tools:text="Nguyễn Văn Chủ" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="@string/my_room_role_landlord"
                            android:textColor="@color/rentify_text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btnCallLandlord"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_my_room_icon_button"
                        android:clickable="true"
                        android:contentDescription="@string/my_room_call"
                        android:focusable="true"
                        android:padding="10dp"
                        android:src="@drawable/ic_phone_outline"
                        app:tint="@color/rentify_icon_slate" />

                    <ImageView
                        android:id="@+id/btnChatLandlord"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_my_room_icon_button"
                        android:clickable="true"
                        android:contentDescription="@string/my_room_chat"
                        android:focusable="true"
                        android:padding="10dp"
                        android:src="@drawable/ic_nav_chat"
                        app:tint="@color/rentify_icon_slate" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRoommates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Multi Rooms / Contract List State -->
        <LinearLayout
            android:id="@+id/layoutMultiRooms"
            android:background="@color/rentify_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="gone">

            <!-- Top Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingTop="22dp"
                android:paddingBottom="@dimen/spacing_sm">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:text="@string/my_rooms_title"
                    android:textColor="@color/rentify_text"
                    android:textSize="22sp" />
            </RelativeLayout>

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayoutContracts"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="@dimen/spacing_xs"
                android:background="@color/rentify_surface"
                app:tabGravity="fill"
                app:tabIndicatorColor="@color/rentify_primary"
                app:tabIndicatorFullWidth="true"
                app:tabIndicatorHeight="2dp"
                app:tabMode="fixed"
                app:tabPaddingEnd="0dp"
                app:tabPaddingStart="0dp"
                app:tabRippleColor="@null" />

            <View
                android:id="@+id/dividerTabs"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/rentify_divider" />

            <!-- Content Area: RecyclerView & Empty View -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvContractsList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingHorizontal="14dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="@dimen/spacing_hero" />

                <LinearLayout
                    android:id="@+id/layoutEmptyContracts"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/spacing_xl"
                    android:paddingBottom="@dimen/spacing_hero"
                    android:visibility="gone"
                    tools:visibility="gone">

                    <TextView
                        android:id="@+id/tvEmptyContractsTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_medium"
                        android:textColor="@color/rentify_text"
                        android:textSize="16sp"
                        tools:text="Bạn chưa thuê phòng nào" />

                    <TextView
                        android:id="@+id/tvEmptyContractsDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:gravity="center"
                        android:textColor="@color/rentify_text_muted"
                        android:textSize="13sp"
                        tools:text="Phòng bạn thuê sẽ hiện ở đây." />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEmptyFindRoom"
                        style="@style/Widget.Rentify.PillButton"
                        android:layout_width="wrap_content"
                        android:layout_height="46dp"
                        android:layout_marginTop="18dp"
                        android:minHeight="46dp"
                        android:paddingHorizontal="@dimen/spacing_xl"
                        android:text="@string/my_rooms_find_room"
                        app:icon="@drawable/ic_search" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- Loading indicator -->
        <com.rentify.app.tenant.ui.component.TenantLoadingView
