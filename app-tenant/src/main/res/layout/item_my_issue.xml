<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_md"
    android:layout_marginVertical="@dimen/spacing_sm"
    app:cardBackgroundColor="@color/rentify_surface"
    app:cardCornerRadius="@dimen/radius_lg"
    app:cardElevation="0dp"
    app:strokeColor="@color/rentify_border_soft"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <!-- Header: Status + Urgency badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_issue_status_badge"
                android:fontFamily="@font/plus_jakarta_sans"
                android:paddingHorizontal="@dimen/spacing_smd"
                android:paddingVertical="@dimen/spacing_xs"
                android:textColor="@color/rentify_text_secondary"
                android:textSize="11sp"
                tools:text="Chờ tiếp nhận" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvUrgencyBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="● Trung bình" />
        </LinearLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_smd"
            android:ellipsize="end"
            android:fontFamily="@font/plus_jakarta_sans"
            android:maxLines="2"
            android:textColor="@color/rentify_text"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Vòi xịt bồn cầu bị rò rỉ nước liên tục" />

        <!-- Info row: Category & Room name -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivCategoryIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="Danh mục"
                android:src="@drawable/ic_issue_other"
                app:tint="@color/rentify_text_muted" />

            <TextView
                android:id="@+id/tvCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:fontFamily="@font/plus_jakarta_sans"
                android:textColor="@color/rentify_text_muted"
                android:textSize="12sp"
                tools:text="Đường nước" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_xs"
                android:text=","
                android:textColor="@color/rentify_text_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvRoomName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/plus_jakarta_sans"
                android:singleLine="true"
                android:textColor="@color/rentify_text_muted"
                android:textSize="12sp"
                tools:text="Phòng P.201 - Nhà Trọ Hòa Khánh" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="@dimen/spacing_smd"
            android:background="@color/rentify_border_soft" />

        <!-- Footer: Date + Assigned Repairer + Chevron -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCreatedAt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/rentify_text_muted"
                android:textSize="12sp"
                tools:text="14:30, 02/11/2026" />

            <TextView
                android:id="@+id/tvAssignedTo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:textColor="@color/rentify_primary"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="Thợ: Nguyễn Văn A"
                tools:visibility="visible" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Xem chi tiết"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/rentify_text_muted" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

