<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- 1) KHUNG TIÊU ĐỀ (Đồng bộ style với các tiêu đề mục khác) -->
    <TextView
        android:id="@+id/tvSectionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_marginEnd="@dimen/spacing_md"
        android:layout_marginBottom="@dimen/spacing_smd"
        android:fontFamily="@font/plus_jakarta_sans"
        android:text="Phòng của tôi"
        android:textColor="#161B2C"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- CHẾ ĐỘ 1 PHÒNG: Card đơn lập (không dùng ViewPager, không hiện dot) -->
    <FrameLayout
        android:id="@+id/containerSingleRoom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:visibility="visible">

        <include
            android:id="@+id/layoutSingleCard"
            layout="@layout/item_my_room_card" />
    </FrameLayout>

    <!-- CHẾ ĐỘ NHIỀU PHÒNG: ViewPager2 vuốt ngang -->
    <FrameLayout
        android:id="@+id/containerMultiRooms"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:visibility="gone"
        tools:visibility="gone">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/pagerMyRooms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingEnd="36dp" />
    </FrameLayout>

    <!-- 3) DOT CHỈ BÁO / PAGE COUNTER (Chỉ hiển thị khi có từ 2 phòng trở lên) -->
    <FrameLayout
        android:id="@+id/containerIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- Dots indicator (khi <= 5 phòng) -->
        <LinearLayout
            android:id="@+id/layoutDotsIndicator"
            android:layout_width="wrap_content"
            android:layout_height="6dp"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:orientation="horizontal" />

        <!-- Counter dạng chữ (khi > 5 phòng, ví dụ 2/6) -->
        <TextView
            android:id="@+id/tvRoomPageCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/plus_jakarta_sans"
            android:textColor="#6B7280"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="2/6" />
    </FrameLayout>

</LinearLayout>
