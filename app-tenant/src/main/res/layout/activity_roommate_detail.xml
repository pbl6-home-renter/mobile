<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rentify_background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/rentify_surface"
        app:elevation="1dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarDetail"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/rentify_text_primary"
            app:title="Hồ sơ bạn ở ghép"
            app:titleTextAppearance="@style/RentifyToolbarTitleText" />
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="88dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header Profile Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/rentify_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/rentify_divider"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivDetailAvatar"
                            android:layout_width="76dp"
                            android:layout_height="76dp"
                            android:background="#E2E8F0"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_user_circle"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

                        <TextView
                            android:id="@+id/tvDetailName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:textColor="@color/rentify_text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:text="Nguyễn Thu Hà" />

                        <TextView
                            android:id="@+id/tvDetailInfoSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:textColor="@color/rentify_neutral"
                            android:textSize="13sp"
                            tools:text="Nữ · 22 tuổi · Sinh viên ĐH Bách Khoa" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- AI Match Analysis Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAiAnalysis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="#F5F3FF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/rentify_button_border_start"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_ai_sparkle"
                                app:tint="@color/rentify_primary_gradient_end" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="Phân tích tương thích AI"
                                android:textColor="@color/rentify_text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvDetailMatchScore"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_pill_badge_role"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:textColor="@color/rentify_primary_gradient_end"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                tools:text="92% Tương thích" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvDetailAiAdvice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:lineSpacingExtra="3dp"
                            android:textColor="@color/rentify_text_secondary"
                            android:textSize="13sp"
                            tools:text="Cả hai đều có thói quen dậy sớm, nấu ăn tại phòng và không hút thuốc. Mức độ phù hợp lối sống và ngân sách rất cao." />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Room Criteria Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="@color/rentify_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/rentify_divider"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="Tiêu chí tìm phòng"
                            android:textColor="@color/rentify_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="Ngân sách dự kiến: "
                                android:textColor="@color/rentify_neutral"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvDetailBudget"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:textColor="@color/rentify_primary_gradient_start"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:text="1.500.000 - 2.500.000 đ" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="Khu vực mong muốn: "
                                android:textColor="@color/rentify_neutral"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvDetailArea"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:textColor="@color/rentify_text_primary"
                                android:textSize="13sp"
                                tools:text="Liên Chiểu · Gần ĐH Bách Khoa" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Lifestyle & Habits Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="@color/rentify_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/rentify_divider"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="Lối sống và thói quen"
                            android:textColor="@color/rentify_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TableLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:stretchColumns="1">

                            <TableRow android:layout_marginBottom="8dp">
                                <TextView
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:text="Ngăn nắp, gọn gàng:"
                                    android:textColor="@color/rentify_neutral"
                                    android:textSize="13sp" />
                                <TextView
                                    android:id="@+id/tvHabitClean"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:gravity="end"
                                    android:textStyle="bold"
                                    android:textSize="13sp"
                                    tools:text="Có" />
                            </TableRow>

                            <TableRow android:layout_marginBottom="8dp">
                                <TextView
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:text="Giờ giấc sinh hoạt:"
                                    android:textColor="@color/rentify_neutral"
                                    android:textSize="13sp" />
                                <TextView
                                    android:id="@+id/tvHabitSleep"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:gravity="end"
                                    android:textStyle="bold"
                                    android:textSize="13sp"
                                    tools:text="Dậy sớm" />
                            </TableRow>

                            <TableRow android:layout_marginBottom="8dp">
                                <TextView
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:text="Nấu ăn tại phòng:"
                                    android:textColor="@color/rentify_neutral"
                                    android:textSize="13sp" />
                                <TextView
                                    android:id="@+id/tvHabitCooking"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:gravity="end"
                                    android:textStyle="bold"
                                    android:textSize="13sp"
                                    tools:text="Thường xuyên" />
                            </TableRow>

                            <TableRow android:layout_marginBottom="8dp">
                                <TextView
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:text="Thú cưng:"
                                    android:textColor="@color/rentify_neutral"
                                    android:textSize="13sp" />
                                <TextView
                                    android:id="@+id/tvHabitPet"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:gravity="end"
                                    android:textStyle="bold"
                                    android:textSize="13sp"
                                    tools:text="Không nuôi" />
                            </TableRow>

                            <TableRow android:layout_marginBottom="8dp">
                                <TextView
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:text="Hút thuốc:"
                                    android:textColor="@color/rentify_neutral"
                                    android:textSize="13sp" />
                                <TextView
                                    android:id="@+id/tvHabitSmoking"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:gravity="end"
                                    android:textStyle="bold"
                                    android:textSize="13sp"
                                    tools:text="Không" />
                            </TableRow>

                            <TableRow>
                                <TextView
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:text="Dẫn bạn bè về phòng:"
                                    android:textColor="@color/rentify_neutral"
                                    android:textSize="13sp" />
                                <TextView
                                    android:id="@+id/tvHabitGuests"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:gravity="end"
                                    android:textStyle="bold"
                                    android:textSize="13sp"
                                    tools:text="Hạn chế" />
                            </TableRow>
                        </TableLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Bio Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="@color/rentify_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/rentify_divider"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="Giới thiệu bản thân"
                            android:textColor="@color/rentify_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDetailBio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:lineSpacingExtra="3dp"
                            android:textColor="@color/rentify_text_secondary"
                            android:textSize="13sp"
                            tools:text="Mình là sinh viên năm cuối, tính tình hòa đồng, sạch sẽ, không hút thuốc. Cần tìm bạn nữ ở ghép share tiền phòng." />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Loading indicator -->
        <ProgressBar
            android:id="@+id/pbDetailLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Bottom Fixed Action Bar -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/rentify_surface"
            android:elevation="8dp"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSendMatchRequest"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:backgroundTint="@color/rentify_primary_gradient_start"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Gửi lời mời ghép đôi"
                android:textColor="@color/rentify_on_primary"
                android:textSize="15sp"
                app:cornerRadius="12dp"
                app:iconGravity="textStart"
                app:iconSize="18dp"
                app:iconTint="@color/rentify_on_primary" />
        </FrameLayout>
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>

