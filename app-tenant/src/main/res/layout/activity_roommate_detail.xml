<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rentify_surface">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/rentify_surface"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarDetail"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/rentify_text"
            app:title="Hồ sơ bạn ở ghép"
            app:titleTextAppearance="@style/TextAppearance.Rentify.ToolbarTitle" />
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="@dimen/spacing_bottom_clearance">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <!-- Header Profile Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/rentify_surface"
                    app:cardCornerRadius="@dimen/radius_lg"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/rentify_border_soft"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_ml">

                        <com.rentify.app.core.ui.view.RentifyAvatarView
                            android:id="@+id/ivDetailAvatar"
                            android:layout_width="76dp"
                            android:layout_height="76dp"
                            app:avatarSize="76dp" />

                        <TextView
                            android:id="@+id/tvDetailName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_smd"
                            android:fontFamily="@font/plus_jakarta_sans_medium"
                            android:textColor="@color/rentify_text"
                            android:textSize="18sp"
                            tools:text="Nguyễn Thu Hà" />

                        <TextView
                            android:id="@+id/tvDetailInfoSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:textColor="@color/rentify_text_muted"
                            android:textSize="13sp"
                            tools:text="Nữ · 22 tuổi · Sinh viên ĐH Bách Khoa" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- AI Match Analysis Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAiAnalysis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    app:cardBackgroundColor="#F5F3FF"
                    app:cardCornerRadius="@dimen/radius_lg"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/rentify_button_border_start"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_ai_sparkle"
                                app:tint="@color/rentify_primary_gradient_end" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_sm"
                                android:layout_weight="1"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="Phân tích tương thích AI"
                                android:textColor="@color/rentify_text"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvDetailMatchScore"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_pill_badge_role"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:paddingHorizontal="@dimen/spacing_smd"
                                android:paddingVertical="@dimen/spacing_xs"
                                android:textColor="@color/rentify_primary_gradient_end"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                tools:text="92% Tương thích" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvDetailAiAdvice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_smd"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:lineSpacingExtra="3dp"
                            android:textColor="@color/rentify_text_secondary"
                            android:textSize="13sp"
                            tools:text="Cả hai đều có thói quen dậy sớm, nấu ăn tại phòng và không hút thuốc. Mức độ phù hợp lối sống và ngân sách rất cao." />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Room Criteria Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    app:cardBackgroundColor="@color/rentify_surface"
                    app:cardCornerRadius="@dimen/radius_lg"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/rentify_border_soft"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="Tiêu chí tìm phòng"
                            android:textColor="@color/rentify_text"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_smd"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="Ngân sách dự kiến: "
                                android:textColor="@color/rentify_text_muted"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvDetailBudget"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:textColor="@color/rentify_primary_gradient_start"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:text="1.500.000 - 2.500.000 đ" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="Khu vực mong muốn: "
                                android:textColor="@color/rentify_text_muted"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvDetailArea"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:textColor="@color/rentify_text"
                                android:textSize="13sp"
                                tools:text="Liên Chiểu · Gần ĐH Bách Khoa" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Lifestyle & Habits Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    app:cardBackgroundColor="@color/rentify_surface"
                    app:cardCornerRadius="@dimen/radius_lg"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/rentify_border_soft"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="Lối sống và thói quen"
                            android:textColor="@color/rentify_text"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TableLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_smd"
                            android:stretchColumns="1">

                            <TableRow android:layout_marginBottom="@dimen/spacing_sm">
                                <TextView
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:text="Ngăn nắp, gọn gàng:"
                                    android:textColor="@color/rentify_text_muted"
                                    android:textSize="13sp" />
                                <TextView
                                    android:id="@+id/tvHabitClean"
                                    android:textColor="@color/rentify_text_primary"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:gravity="end"
                                    android:textStyle="bold"
                                    android:textSize="13sp"
                                    tools:text="Có" />
                            </TableRow>

                            <TableRow android:layout_marginBottom="@dimen/spacing_sm">
                                <TextView
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:text="Giờ giấc sinh hoạt:"
                                    android:textColor="@color/rentify_text_muted"
                                    android:textSize="13sp" />
                                <TextView
                                    android:id="@+id/tvHabitSleep"
                                    android:textColor="@color/rentify_text_primary"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:gravity="end"
                                    android:textStyle="bold"
                                    android:textSize="13sp"
                                    tools:text="Dậy sớm" />
                            </TableRow>

                            <TableRow android:layout_marginBottom="@dimen/spacing_sm">
                                <TextView
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:text="Nấu ăn tại phòng:"
                                    android:textColor="@color/rentify_text_muted"
                                    android:textSize="13sp" />
                                <TextView
                                    android:id="@+id/tvHabitCooking"
                                    android:textColor="@color/rentify_text_primary"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:gravity="end"
                                    android:textStyle="bold"
                                    android:textSize="13sp"
                                    tools:text="Thường xuyên" />
                            </TableRow>

                            <TableRow android:layout_marginBottom="@dimen/spacing_sm">
                                <TextView
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:text="Thú cưng:"
                                    android:textColor="@color/rentify_text_muted"
                                    android:textSize="13sp" />
                                <TextView
                                    android:id="@+id/tvHabitPet"
                                    android:textColor="@color/rentify_text_primary"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:gravity="end"
                                    android:textStyle="bold"
                                    android:textSize="13sp"
                                    tools:text="Không nuôi" />
                            </TableRow>

                            <TableRow android:layout_marginBottom="@dimen/spacing_sm">
                                <TextView
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:text="Hút thuốc:"
                                    android:textColor="@color/rentify_text_muted"
                                    android:textSize="13sp" />
                                <TextView
                                    android:id="@+id/tvHabitSmoking"
                                    android:textColor="@color/rentify_text_primary"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:gravity="end"
                                    android:textStyle="bold"
                                    android:textSize="13sp"
                                    tools:text="Không" />
                            </TableRow>

                            <TableRow>
                                <TextView
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:text="Dẫn bạn bè về phòng:"
                                    android:textColor="@color/rentify_text_muted"
                                    android:textSize="13sp" />
                                <TextView
                                    android:id="@+id/tvHabitGuests"
                                    android:textColor="@color/rentify_text_primary"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:gravity="end"
                                    android:textStyle="bold"
                                    android:textSize="13sp"
                                    tools:text="Hạn chế" />
                            </TableRow>
                        </TableLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Bio Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    app:cardBackgroundColor="@color/rentify_surface"
                    app:cardCornerRadius="@dimen/radius_lg"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/rentify_border_soft"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="Giới thiệu bản thân"
                            android:textColor="@color/rentify_text"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDetailBio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:lineSpacingExtra="3dp"
                            android:textColor="@color/rentify_text_secondary"
                            android:textSize="13sp"
                            tools:text="Mình là sinh viên năm cuối, tính tình hòa đồng, sạch sẽ, không hút thuốc. Cần tìm bạn nữ ở ghép share tiền phòng." />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Loading indicator -->
        <com.rentify.app.tenant.ui.component.TenantLoadingView
            android:id="@+id/pbDetailLoading"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Bottom Fixed Action Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/rentify_surface"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/rentify_divider" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSendMatchRequest"
                style="@style/Widget.Rentify.PillButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_smd"
                android:layout_marginBottom="@dimen/spacing_md"
                android:text="Gửi lời mời ghép đôi" />
        </LinearLayout>
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>

