<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="6dp">

    <include
        android:id="@+id/layoutDateSeparator"
        layout="@layout/layout_message_date_separator" />

    <!-- 3.6 Thông báo hệ thống: chữ căn giữa 12sp rentify_text_faint, tối đa 2 dòng, không nền, không viền -->
    <TextView
        android:id="@+id/txtSystemMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/plus_jakarta_sans"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:textColor="@color/rentify_text_faint"
        android:textSize="12sp"
        tools:text="Lan đã được thêm vào nhóm, 08:00" />

</LinearLayout>
