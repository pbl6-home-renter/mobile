<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardArea"
    android:layout_width="wrap_content"
    android:layout_height="66dp"
    android:layout_marginEnd="10dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/rentify_card_near_bg"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#DBEAFE"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:minWidth="108dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAreaType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:text="Quận"
                android:textColor="@color/rentify_text_secondary"
                android:textSize="11sp"
                tools:text="Quận" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAreaName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:singleLine="true"
            android:textColor="@color/rentify_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Hòa Khánh" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
