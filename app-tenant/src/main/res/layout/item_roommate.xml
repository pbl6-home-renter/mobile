<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp">

    <com.rentify.app.core.ui.view.RentifyAvatarView
        android:id="@+id/avatarRoommate"
        android:layout_width="44dp"
        android:layout_height="44dp"
        app:avatarSize="44dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRoommateName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:ellipsize="end"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:maxLines="1"
                android:textColor="@color/rentify_text"
                android:textSize="14sp"
                tools:text="Trần Minh Tâm" />

            <TextView
                android:id="@+id/tvRepresentativeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_my_room_badge"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="@string/my_room_representative"
                android:textColor="@color/rentify_teal"
                android:textSize="10sp"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/plus_jakarta_sans"
            android:text="@string/my_room_role_roommate"
            android:textColor="@color/rentify_text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/btnChatRoommate"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_my_room_icon_button"
        android:clickable="true"
        android:contentDescription="@string/my_room_chat"
        android:focusable="true"
        android:padding="10dp"
        android:src="@drawable/ic_nav_chat"
        app:tint="@color/rentify_icon_slate" />

</LinearLayout>
