<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rentify_background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clMainContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="600dp">

            <ImageView
                android:id="@+id/ivAuthBanner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@string/auth_register_title"
                android:scaleType="fitXY"
                android:src="@drawable/img_auth_banner"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:src="@drawable/img_onboarding_1" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clFormContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/spacing_lg"
                android:paddingBottom="@dimen/spacing_xl"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ivAuthBanner">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:text="@string/auth_register_title"
                    android:textColor="@color/rentify_text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:fontFamily="@font/plus_jakarta_sans_regular"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/auth_register_subtitle"
                    android:textColor="@color/rentify_text_secondary"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTitle" />

                <!-- Name Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilName"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:hint="@string/auth_register_name_label"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_md"
                    app:boxCornerRadiusBottomStart="@dimen/radius_md"
                    app:boxCornerRadiusTopEnd="@dimen/radius_md"
                    app:boxCornerRadiusTopStart="@dimen/radius_md"
                    app:boxStrokeColor="@color/rentify_divider"
                    app:cursorColor="@color/rentify_text_primary"
                    app:hintTextColor="@color/rentify_text_primary"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_regular"
                        android:inputType="textCapWords|textPersonName"
                        android:textColor="@color/rentify_text_primary"
                        android:textColorHint="@color/rentify_neutral"
                        android:textCursorDrawable="@drawable/bg_cursor_primary"
                        android:textSize="15sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Email Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilEmail"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:hint="@string/auth_register_email_label"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_md"
                    app:boxCornerRadiusBottomStart="@dimen/radius_md"
                    app:boxCornerRadiusTopEnd="@dimen/radius_md"
                    app:boxCornerRadiusTopStart="@dimen/radius_md"
                    app:boxStrokeColor="@color/rentify_divider"
                    app:cursorColor="@color/rentify_text_primary"
                    app:hintTextColor="@color/rentify_text_primary"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tilName">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_regular"
                        android:inputType="textEmailAddress"
                        android:textColor="@color/rentify_text_primary"
                        android:textColorHint="@color/rentify_neutral"
                        android:textCursorDrawable="@drawable/bg_cursor_primary"
                        android:textSize="15sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Phone Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPhone"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:hint="@string/auth_register_phone_label"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_md"
                    app:boxCornerRadiusBottomStart="@dimen/radius_md"
                    app:boxCornerRadiusTopEnd="@dimen/radius_md"
                    app:boxCornerRadiusTopStart="@dimen/radius_md"
                    app:boxStrokeColor="@color/rentify_divider"
                    app:cursorColor="@color/rentify_text_primary"
                    app:hintTextColor="@color/rentify_text_primary"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tilEmail">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_regular"
                        android:inputType="phone"
                        android:textColor="@color/rentify_text_primary"
                        android:textColorHint="@color/rentify_neutral"
                        android:textCursorDrawable="@drawable/bg_cursor_primary"
                        android:textSize="15sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Password Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPassword"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:hint="@string/auth_register_password_label"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_md"
                    app:boxCornerRadiusBottomStart="@dimen/radius_md"
                    app:boxCornerRadiusTopEnd="@dimen/radius_md"
                    app:boxCornerRadiusTopStart="@dimen/radius_md"
                    app:boxStrokeColor="@color/rentify_divider"
                    app:cursorColor="@color/rentify_text_primary"
                    app:endIconMode="password_toggle"
                    app:hintTextColor="@color/rentify_text_primary"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tilPhone">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_regular"
                        android:inputType="textPassword"
                        android:textColor="@color/rentify_text_primary"
                        android:textColorHint="@color/rentify_neutral"
                        android:textCursorDrawable="@drawable/bg_cursor_primary"
                        android:textSize="15sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Confirm Password Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilConfirmPassword"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:hint="@string/auth_register_confirm_password_label"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_md"
                    app:boxCornerRadiusBottomStart="@dimen/radius_md"
                    app:boxCornerRadiusTopEnd="@dimen/radius_md"
                    app:boxCornerRadiusTopStart="@dimen/radius_md"
                    app:boxStrokeColor="@color/rentify_divider"
                    app:cursorColor="@color/rentify_text_primary"
                    app:endIconMode="password_toggle"
                    app:hintTextColor="@color/rentify_text_primary"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tilPassword">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etConfirmPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_regular"
                        android:inputType="textPassword"
                        android:textColor="@color/rentify_text_primary"
                        android:textColorHint="@color/rentify_neutral"
                        android:textCursorDrawable="@drawable/bg_cursor_primary"
                        android:textSize="15sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Terms & Conditions Agreement -->
                <LinearLayout
                    android:id="@+id/llTermsContainer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tilConfirmPassword">

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cbTerms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        app:buttonTint="@color/sl_checkbox_terms" />

                    <TextView
                        android:id="@+id/tvTerms"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/plus_jakarta_sans_regular"
                        android:textColor="@color/rentify_text_secondary"
                        android:textSize="13sp"
                        tools:text="Tôi đồng ý với Điều khoản dịch vụ và Chính sách bảo mật" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvError"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:textColor="@color/rentify_error"
                    android:textSize="13sp"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/llTermsContainer"
                    tools:text="Đã xảy ra lỗi khi đăng ký"
                    tools:visibility="visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRegister"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:background="@drawable/bg_button_gradient"
                    android:enabled="false"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:text="@string/auth_register_button"
                    android:textColor="@color/sl_button_primary_text"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null"
                    app:cornerRadius="@dimen/radius_button"
                    app:elevation="2dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvError"
                    app:rippleColor="#30FFFFFF" />

                <ProgressBar
                    android:id="@+id/pbLoading"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:elevation="4dp"
                    android:indeterminateTint="@color/rentify_on_primary"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@id/btnRegister"
                    app:layout_constraintEnd_toEndOf="@id/btnRegister"
                    app:layout_constraintStart_toStartOf="@id/btnRegister"
                    app:layout_constraintTop_toTopOf="@id/btnRegister" />

                <LinearLayout
                    android:id="@+id/llFooter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/spacing_md"
                    android:paddingVertical="@dimen/spacing_sm"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/btnRegister">

                    <TextView
                        android:id="@+id/tvAlreadyHaveAccount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_regular"
                        android:text="@string/auth_register_already_have_account"
                        android:textColor="@color/rentify_text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvLoginNow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:padding="@dimen/spacing_xs"
                        android:text="@string/auth_register_login_now"
                        android:textColor="@color/rentify_primary_gradient_start"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
