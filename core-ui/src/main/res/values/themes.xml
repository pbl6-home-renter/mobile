<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Rentify" parent="Theme.Material3.Light.NoActionBar">
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>

        <item name="colorPrimary">@color/rentify_primary</item>
        <item name="colorOnPrimary">@color/rentify_on_primary</item>
        <item name="colorPrimaryContainer">@color/rentify_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/rentify_on_primary_container</item>
        <item name="colorSecondary">@color/rentify_teal_primary</item>
        <item name="colorOnSecondary">@color/rentify_on_primary</item>
        <item name="colorSecondaryContainer">@color/rentify_teal_surface</item>
        <item name="colorOnSecondaryContainer">@color/rentify_teal_darkest</item>
        <item name="android:colorBackground">@color/rentify_background</item>
        <item name="colorOnBackground">@color/rentify_text_primary</item>
        <item name="colorSurface">@color/rentify_surface</item>
        <item name="colorOnSurface">@color/rentify_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/rentify_text_secondary</item>
        <item name="colorOutline">@color/rentify_neutral</item>
        <item name="colorOutlineVariant">@color/rentify_divider</item>
        <item name="colorError">@color/rentify_error</item>
        <item name="elevationOverlayEnabled">false</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar">true</item>

        <item name="materialButtonStyle">@style/Widget.Rentify.Button</item>
        <item name="textInputStyle">@style/Widget.Rentify.TextInputLayout</item>
        <item name="materialCardViewStyle">@style/Widget.Rentify.CardView</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Rentify.MaterialAlertDialog</item>
    </style>

    <style name="ThemeOverlay.Rentify.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/MaterialAlertDialog.Rentify</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.Rentify.Title.Text</item>
        <item name="materialAlertDialogBodyTextStyle">@style/MaterialAlertDialog.Rentify.Body.Text</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Rentify.Dialog.PositiveButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Rentify.Dialog.NegativeButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Rentify.Dialog.NegativeButton</item>
    </style>

    <style name="MaterialAlertDialog.Rentify" parent="MaterialAlertDialog.Material3">
        <item name="backgroundTint">@color/rentify_surface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Rentify.Dialog</item>
    </style>

    <style name="ShapeAppearance.Rentify.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_xl</item>
    </style>

    <style name="MaterialAlertDialog.Rentify.Title.Text" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="android:textColor">@color/rentify_text_primary</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="MaterialAlertDialog.Rentify.Body.Text" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:fontFamily">@font/plus_jakarta_sans_regular</item>
        <item name="fontFamily">@font/plus_jakarta_sans_regular</item>
        <item name="android:textColor">@color/rentify_text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="Widget.Rentify.Dialog.PositiveButton" parent="Widget.Material3.Button">
        <item name="android:fontFamily">@font/plus_jakarta_sans_medium</item>
        <item name="fontFamily">@font/plus_jakarta_sans_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="backgroundTint">@color/rentify_primary</item>
        <item name="android:textColor">@color/rentify_on_primary</item>
    </style>

    <style name="Widget.Rentify.Dialog.NegativeButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:fontFamily">@font/plus_jakarta_sans_medium</item>
        <item name="fontFamily">@font/plus_jakarta_sans_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:textColor">@color/rentify_text_secondary</item>
    </style>

    <style name="Widget.Rentify.Button" parent="Widget.Material3.Button">
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Rentify.PillButton" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:background">@drawable/bg_pill_button</item>
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/text_pill_button</item>
        <item name="iconTint">@color/text_pill_button</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">15sp</item>
        <item name="fontFamily">@font/plus_jakarta_sans_medium</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="iconGravity">textStart</item>
        <item name="iconSize">19dp</item>
        <item name="iconPadding">8dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">6dp</item>
        <item name="android:outlineSpotShadowColor" tools:targetApi="p">@color/rentify_primary</item>
    </style>

    <style name="Widget.Rentify.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_md</item>
        <item name="boxStrokeColor">@color/rentify_neutral</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
    </style>

    <style name="Widget.Rentify.CardView" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/rentify_divider</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/rentify_surface</item>
    </style>

    <style name="TextAppearance.Rentify.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textColor">@color/rentify_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Rentify.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/rentify_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Rentify.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/rentify_text_primary</item>
    </style>

    <style name="TextAppearance.Rentify.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/rentify_text_secondary</item>
    </style>

    <style name="RentifyBottomNavActive" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="RentifyTabTextAppearance" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="RentifyToolbarTitleText" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/rentify_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
