<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Rentify" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/rentify_primary</item>
        <item name="colorOnPrimary">@color/rentify_on_primary</item>
        <item name="colorPrimaryContainer">@color/rentify_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/rentify_on_primary_container</item>
        <item name="colorSecondary">@color/rentify_primary</item>
        <item name="colorOnSecondary">@color/rentify_on_primary</item>
        <item name="colorSecondaryContainer">@color/rentify_primary_container</item>
        <item name="colorOnSecondaryContainer">@color/rentify_on_primary_container</item>
        <item name="android:colorBackground">@color/rentify_background</item>
        <item name="colorOnBackground">@color/rentify_text_primary</item>
        <item name="colorSurface">@color/rentify_surface</item>
        <item name="colorOnSurface">@color/rentify_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/rentify_text_secondary</item>
        <item name="colorOutline">@color/rentify_neutral</item>
        <item name="colorOutlineVariant">@color/rentify_divider</item>
        <item name="colorError">@color/rentify_error</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar">true</item>

        <item name="materialButtonStyle">@style/Widget.Rentify.Button</item>
        <item name="textInputStyle">@style/Widget.Rentify.TextInputLayout</item>
        <item name="materialCardViewStyle">@style/Widget.Rentify.CardView</item>
    </style>

    <style name="Widget.Rentify.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Rentify.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_md</item>
        <item name="boxStrokeColor">@color/rentify_neutral</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
    </style>

    <style name="Widget.Rentify.CardView" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/rentify_divider</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/rentify_surface</item>
    </style>

    <style name="TextAppearance.Rentify.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textColor">@color/rentify_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Rentify.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/rentify_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Rentify.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/rentify_text_primary</item>
    </style>

    <style name="TextAppearance.Rentify.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/rentify_text_secondary</item>
    </style>

</resources>
